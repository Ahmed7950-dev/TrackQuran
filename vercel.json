{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/report/:id",
      "destination": "/api/portal?p=/report/:id"
    },
    {
      "source": "/portal/:id",
      "destination": "/api/portal?p=/portal/:id"
    },
    {
      "source": "/arabic/s/:id",
      "destination": "/api/portal?p=/arabic/s/:id"
    },
    {
      "source": "/family/:id",
      "destination": "/api/portal?p=/family/:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
