{"verses": [{"verse_key": "81:1", "text_uthmani": "اِذَا الشَّمْسُ كُوِّرَتْۙۖ"}, {"verse_key": "81:2", "text_uthmani": "وَاِذَا النُّجُومُ انْكَدَرَتْۙۖ"}, {"verse_key": "81:3", "text_uthmani": "وَاِذَا الْجِبَالُ سُيِّرَتْۙۖ"}, {"verse_key": "81:4", "text_uthmani": "وَاِذَا الْعِشَارُ عُطِّلَتْۙۖ"}, {"verse_key": "81:5", "text_uthmani": "وَاِذَا الْوُحُوشُ حُشِرَتْۙۖ"}, {"verse_key": "81:6", "text_uthmani": "وَاِذَا الْبِحَارُ سُجِّرَتْۙۖ"}, {"verse_key": "81:7", "text_uthmani": "وَاِذَا النُّفُوسُ زُوِّجَتْۙۖ"}, {"verse_key": "81:8", "text_uthmani": "وَاِذَا الْمَوْءُ۫دَةُ سُئِلَتْۙ"}, {"verse_key": "81:9", "text_uthmani": "بِاَيِّ ذَنْبٍ قُتِلَتْۚ"}, {"verse_key": "81:10", "text_uthmani": "وَاِذَا الصُّحُفُ نُشِرَتْۙۖ"}, {"verse_key": "81:11", "text_uthmani": "وَاِذَا السَّمَٓاءُ كُشِطَتْۙۖ"}, {"verse_key": "81:12", "text_uthmani": "وَاِذَا الْجَح۪يمُ سُعِّرَتْۙۖ"}, {"verse_key": "81:13", "text_uthmani": "وَاِذَا الْجَنَّةُ اُزْلِفَتْۙۖ"}, {"verse_key": "81:14", "text_uthmani": "عَلِمَتْ نَفْسٌ مَٓا اَحْضَرَتْۜ"}, {"verse_key": "81:15", "text_uthmani": "فَلَٓا اُقْسِمُ بِالْخُنَّسِۙ"}, {"verse_key": "81:16", "text_uthmani": "اَلْجَوَارِ الْكُنَّسِۙ"}, {"verse_key": "81:17", "text_uthmani": "وَالَّيْلِ اِذَا عَسْعَسَۙ"}, {"verse_key": "81:18", "text_uthmani": "وَالصُّبْحِ اِذَا تَنَفَّسَۙ"}, {"verse_key": "81:19", "text_uthmani": "اِنَّهُ لَقَوْلُ رَسُولٍ كَر۪يمٍۙ"}, {"verse_key": "81:20", "text_uthmani": "ذ۪ي قُوَّةٍ عِنْدَ ذِي الْعَرْشِ مَك۪ينٍۙ"}, {"verse_key": "81:21", "text_uthmani": "مُطَاعٍ ثَمَّ اَم۪ينٍۜ"}, {"verse_key": "81:22", "text_uthmani": "وَمَا صَاحِبُكُمْ بِمَجْنُونٍۚ"}, {"verse_key": "81:23", "text_uthmani": "وَلَقَدْ رَاٰهُ بِالْاُفُقِ الْمُب۪ينِۚ"}, {"verse_key": "81:24", "text_uthmani": "وَمَا هُوَ عَلَى الْغَيْبِ بِضَن۪ينٍۚ"}, {"verse_key": "81:25", "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَيْطَانٍ رَج۪يمٍۚ"}, {"verse_key": "81:26", "text_uthmani": "فَاَيْنَ تَذْهَبُونَۜ"}, {"verse_key": "81:27", "text_uthmani": "اِنْ هُوَ اِلَّا ذِكْرٌ لِلْعَالَم۪ينَۙ"}, {"verse_key": "81:28", "text_uthmani": "لِمَنْ شَٓاءَ مِنْكُمْ اَنْ يَسْتَق۪يمَ"}, {"verse_key": "81:29", "text_uthmani": "وَمَا تَشَٓاؤُ۫نَ اِلَّٓا اَنْ يَشَٓاءَ اللّٰهُ رَبُّ الْعَالَم۪ينَ"}]}