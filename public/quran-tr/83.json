{"verses": [{"verse_key": "83:1", "text_uthmani": "وَيْلٌ لِلْمُطَفِّف۪ينَۙ"}, {"verse_key": "83:2", "text_uthmani": "اَلَّذ۪ينَ اِذَا اكْتَالُوا عَلَى النَّاسِ يَسْتَوْفُونَۘ"}, {"verse_key": "83:3", "text_uthmani": "وَاِذَا كَالُوهُمْ اَوْ وَزَنُوهُمْ يُخْسِرُونَۜ"}, {"verse_key": "83:4", "text_uthmani": "اَلَا يَظُنُّ اُو۬لٰٓئِكَ اَنَّهُمْ مَبْعُوثُونَۙ"}, {"verse_key": "83:5", "text_uthmani": "لِيَوْمٍ عَظ۪يمٍۙ"}, {"verse_key": "83:6", "text_uthmani": "يَوْمَ يَقُومُ النَّاسُ لِرَبِّ الْعَالَم۪ينَۜ"}, {"verse_key": "83:7", "text_uthmani": "كَلَّٓا اِنَّ كِتَابَ الْفُجَّارِ لَف۪ي سِجّ۪ينٍۜ"}, {"verse_key": "83:8", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا سِجّ۪ينٌۜ"}, {"verse_key": "83:9", "text_uthmani": "كِتَابٌ مَرْقُومٌۜ"}, {"verse_key": "83:10", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَۙ"}, {"verse_key": "83:11", "text_uthmani": "اَلَّذ۪ينَ يُكَذِّبُونَ بِيَوْمِ الدّ۪ينِۜ"}, {"verse_key": "83:12", "text_uthmani": "وَمَا يُكَذِّبُ بِه۪ٓ اِلَّا كُلُّ مُعْتَدٍ اَث۪يمٍۙ"}, {"verse_key": "83:13", "text_uthmani": "اِذَا تُتْلٰى عَلَيْهِ اٰيَاتُنَا قَالَ اَسَاط۪يرُ الْاَوَّل۪ينَۜ"}, {"verse_key": "83:14", "text_uthmani": "كَلَّا بَلْ۔ رَانَ عَلٰى قُلُوبِهِمْ مَا كَانُوا يَكْسِبُونَ"}, {"verse_key": "83:15", "text_uthmani": "كَلَّٓا اِنَّهُمْ عَنْ رَبِّهِمْ يَوْمَئِذٍ لَمَحْجُوبُونَۜ"}, {"verse_key": "83:16", "text_uthmani": "ثُمَّ اِنَّهُمْ لَصَالُوا الْجَح۪يمِۜ"}, {"verse_key": "83:17", "text_uthmani": "ثُمَّ يُقَالُ هٰذَا الَّذ۪ي كُنْتُمْ بِه۪ تُكَذِّبُونَۜ"}, {"verse_key": "83:18", "text_uthmani": "كَلَّٓا اِنَّ كِتَابَ الْاَبْرَارِ لَف۪ي عِلِّيّ۪ينَۜ"}, {"verse_key": "83:19", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا عِلِّيُّونَۜ"}, {"verse_key": "83:20", "text_uthmani": "كِتَابٌ مَرْقُومٌۙ"}, {"verse_key": "83:21", "text_uthmani": "يَشْهَدُهُ الْمُقَرَّبُونَۜ"}, {"verse_key": "83:22", "text_uthmani": "اِنَّ الْاَبْرَارَ لَف۪ي نَع۪يمٍۙ"}, {"verse_key": "83:23", "text_uthmani": "عَلَى الْاَرَٓائِكِ يَنْظُرُونَۙ"}, {"verse_key": "83:24", "text_uthmani": "تَعْرِفُ ف۪ي وُجُوهِهِمْ نَضْرَةَ النَّع۪يمِۚ"}, {"verse_key": "83:25", "text_uthmani": "يُسْقَوْنَ مِنْ رَح۪يقٍ مَخْتُومٍۙ"}, {"verse_key": "83:26", "text_uthmani": "خِتَامُهُ مِسْكٌۜ وَف۪ي ذٰلِكَ فَلْيَتَنَافَسِ الْمُتَنَافِسُونَۜ"}, {"verse_key": "83:27", "text_uthmani": "وَمِزَاجُهُ مِنْ تَسْن۪يمٍۙ"}, {"verse_key": "83:28", "text_uthmani": "عَيْنًا يَشْرَبُ بِهَا الْمُقَرَّبُونَۜ"}, {"verse_key": "83:29", "text_uthmani": "اِنَّ الَّذ۪ينَ اَجْرَمُوا كَانُوا مِنَ الَّذ۪ينَ اٰمَنُوا يَضْحَكُونَۘ"}, {"verse_key": "83:30", "text_uthmani": "وَاِذَا مَرُّوا بِهِمْ يَتَغَامَزُونَۘ"}, {"verse_key": "83:31", "text_uthmani": "وَاِذَا انْقَلَبُٓوا اِلٰٓى اَهْلِهِمُ انْقَلَبُوا فَكِه۪ينَۘ"}, {"verse_key": "83:32", "text_uthmani": "وَاِذَا رَاَوْهُمْ قَالُٓوا اِنَّ هٰٓؤُ۬لَٓاءِ لَضَٓالُّونَۙ"}, {"verse_key": "83:33", "text_uthmani": "وَمَٓا اُرْسِلُوا عَلَيْهِمْ حَافِظ۪ينَۜ"}, {"verse_key": "83:34", "text_uthmani": "فَالْيَوْمَ الَّذ۪ينَ اٰمَنُوا مِنَ الْكُفَّارِ يَضْحَكُونَۙ"}, {"verse_key": "83:35", "text_uthmani": "عَلَى الْاَرَٓائِكِ يَنْظُرُونَۜ"}, {"verse_key": "83:36", "text_uthmani": "هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوا يَفْعَلُونَ"}]}