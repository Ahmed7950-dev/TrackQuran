{"verses": [{"verse_key": "96:1", "text_uthmani": "اِقْرَأْ بِاسْمِ رَبِّكَ الَّذ۪ي خَلَقَۚ"}, {"verse_key": "96:2", "text_uthmani": "خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍۚ"}, {"verse_key": "96:3", "text_uthmani": "اِقْرَأْ وَرَبُّكَ الْاَكْرَمُۙ"}, {"verse_key": "96:4", "text_uthmani": "اَلَّذ۪ي عَلَّمَ بِالْقَلَمِۙ"}, {"verse_key": "96:5", "text_uthmani": "عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْۜ"}, {"verse_key": "96:6", "text_uthmani": "كَلَّٓا اِنَّ الْاِنْسَانَ لَيَطْغٰىۙ"}, {"verse_key": "96:7", "text_uthmani": "اَنْ رَاٰهُ اسْتَغْنٰىۜ"}, {"verse_key": "96:8", "text_uthmani": "اِنَّ اِلٰى رَبِّكَ الرُّجْعٰىۜ"}, {"verse_key": "96:9", "text_uthmani": "اَرَاَيْتَ الَّذ۪ي يَنْهٰىۙ"}, {"verse_key": "96:10", "text_uthmani": "عَبْدًا اِذَا صَلّٰىۜ"}, {"verse_key": "96:11", "text_uthmani": "اَرَاَيْتَ اِنْ كَانَ عَلَى الْهُدٰىۙ"}, {"verse_key": "96:12", "text_uthmani": "اَوْ اَمَرَ بِالتَّقْوٰىۜ"}, {"verse_key": "96:13", "text_uthmani": "اَرَاَيْتَ اِنْ كَذَّبَ وَتَوَلّٰىۜ"}, {"verse_key": "96:14", "text_uthmani": "اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰىۜ"}, {"verse_key": "96:15", "text_uthmani": "كَلَّا لَئِنْ لَمْ يَنْتَهِ۬ لَنَسْفَعًا بِالنَّاصِيَةِۙ"}, {"verse_key": "96:16", "text_uthmani": "نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍۚ"}, {"verse_key": "96:17", "text_uthmani": "فَلْيَدْعُ نَادِيَهُۙ"}, {"verse_key": "96:18", "text_uthmani": "سَنَدْعُ الزَّبَانِيَةَۙ"}, {"verse_key": "96:19", "text_uthmani": "كَلَّاۜ لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ"}]}