{"verses": [{"verse_key": "1:1", "text_uthmani": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّح۪يمِ"}, {"verse_key": "1:2", "text_uthmani": "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعَالَم۪ينَۙ"}, {"verse_key": "1:3", "text_uthmani": "اَلرَّحْمٰنِ الرَّح۪يمِۙ"}, {"verse_key": "1:4", "text_uthmani": "مَالِكِ يَوْمِ الدّ۪ينِۜ"}, {"verse_key": "1:5", "text_uthmani": "اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَع۪ينُۜ"}, {"verse_key": "1:6", "text_uthmani": "اِهْدِنَا الصِّرَاطَ الْمُسْتَق۪يمَۙ"}, {"verse_key": "1:7", "text_uthmani": "صِرَاطَ الَّذ۪ينَ اَنْعَمْتَ عَلَيْهِمْۙ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّٓالّ۪ينَ"}]}