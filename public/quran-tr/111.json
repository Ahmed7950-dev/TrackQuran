{"verses": [{"verse_key": "111:1", "text_uthmani": "تَبَّتْ يَدَٓا اَب۪ي لَهَبٍ وَتَبَّۜ"}, {"verse_key": "111:2", "text_uthmani": "مَٓا اَغْنٰى عَنْهُ مَالُهُ وَمَا كَسَبَۜ"}, {"verse_key": "111:3", "text_uthmani": "سَيَصْلٰى نَارًا ذَاتَ لَهَبٍۚ"}, {"verse_key": "111:4", "text_uthmani": "وَامْرَاَتُهُۜ حَمَّالَةَ الْحَطَبِۚ"}, {"verse_key": "111:5", "text_uthmani": "ف۪ي ج۪يدِهَا حَبْلٌ مِنْ مَسَدٍ"}]}