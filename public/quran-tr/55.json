{"verses": [{"verse_key": "55:1", "text_uthmani": "اَلرَّحْمٰنُۙ"}, {"verse_key": "55:2", "text_uthmani": "عَلَّمَ الْقُرْاٰنَۜ"}, {"verse_key": "55:3", "text_uthmani": "خَلَقَ الْاِنْسَانَۙ"}, {"verse_key": "55:4", "text_uthmani": "عَلَّمَهُ الْبَيَانَ"}, {"verse_key": "55:5", "text_uthmani": "اَلشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍۖ"}, {"verse_key": "55:6", "text_uthmani": "وَالنَّجْمُ وَالشَّجَرُ يَسْجُدَانِ"}, {"verse_key": "55:7", "text_uthmani": "وَالسَّمَٓاءَ رَفَعَهَا وَوَضَعَ الْم۪يزَانَۙ"}, {"verse_key": "55:8", "text_uthmani": "اَلَّا تَطْغَوْا فِي الْم۪يزَانِ"}, {"verse_key": "55:9", "text_uthmani": "وَاَق۪يمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْم۪يزَانَ"}, {"verse_key": "55:10", "text_uthmani": "وَالْاَرْضَ وَضَعَهَا لِلْاَنَامِۙ"}, {"verse_key": "55:11", "text_uthmani": "ف۪يهَا فَاكِهَةٌۖ وَالنَّخْلُ ذَاتُ الْاَكْمَامِ"}, {"verse_key": "55:12", "text_uthmani": "وَالْحَبُّ ذُو الْعَصْفِ وَالرَّيْحَانُۚ"}, {"verse_key": "55:13", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:14", "text_uthmani": "خَلَقَ الْاِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِۙ"}, {"verse_key": "55:15", "text_uthmani": "وَخَلَقَ الْجَٓانَّ مِنْ مَارِجٍ مِنْ نَارٍۚ"}, {"verse_key": "55:16", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:17", "text_uthmani": "رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِۚ"}, {"verse_key": "55:18", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:19", "text_uthmani": "مَرَجَ الْبَحْرَيْنِ يَلْتَقِيَانِۙ"}, {"verse_key": "55:20", "text_uthmani": "بَيْنَهُمَا بَرْزَخٌ لَا يَبْغِيَانِۚ"}, {"verse_key": "55:21", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:22", "text_uthmani": "يَخْرُجُ مِنْهُمَا اللُّؤْلُؤُ۬ وَالْمَرْجَانُۚ"}, {"verse_key": "55:23", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:24", "text_uthmani": "وَلَهُ الْجَوَارِ الْمُنْشَاٰتُ فِي الْبَحْرِ كَالْاَعْلَامِۚ"}, {"verse_key": "55:25", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ۟"}, {"verse_key": "55:26", "text_uthmani": "كُلُّ مَنْ عَلَيْهَا فَانٍۚ"}, {"verse_key": "55:27", "text_uthmani": "وَيَبْقٰى وَجْهُ رَبِّكَ ذُو الْجَلَالِ وَالْاِكْرَامِۚ"}, {"verse_key": "55:28", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:29", "text_uthmani": "يَسْـَٔلُهُ مَنْ فِي السَّمٰوَاتِ وَالْاَرْضِۜ كُلَّ يَوْمٍ هُوَ ف۪ي شَأْنٍۚ"}, {"verse_key": "55:30", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:31", "text_uthmani": "سَنَفْرُغُ لَكُمْ اَيُّهَ الثَّقَلَانِۚ"}, {"verse_key": "55:32", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:33", "text_uthmani": "يَا مَعْشَرَ الْجِنِّ وَالْاِنْسِ اِنِ اسْتَطَعْتُمْ اَنْ تَنْفُذُوا مِنْ اَقْطَارِ السَّمٰوَاتِ وَالْاَرْضِ فَانْفُذُواۜ لَا تَنْفُذُونَ اِلَّا بِسُلْطَانٍۚ"}, {"verse_key": "55:34", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:35", "text_uthmani": "يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِنْ نَارٍ وَنُحَاسٌ فَلَا تَنْتَصِرَانِۚ"}, {"verse_key": "55:36", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:37", "text_uthmani": "فَاِذَا انْشَقَّتِ السَّمَٓاءُ فَكَانَتْ وَرْدَةً كَالدِّهَانِۚ"}, {"verse_key": "55:38", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:39", "text_uthmani": "فَيَوْمَئِذٍ لَا يُسْـَٔلُ عَنْ ذَنْبِه۪ٓ اِنْسٌ وَلَا جَٓانٌّۚ"}, {"verse_key": "55:40", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:41", "text_uthmani": "يُعْرَفُ الْمُجْرِمُونَ بِس۪يمٰيهُمْ فَيُؤْخَذُ بِالنَّوَاص۪ي وَالْاَقْدَامِۚ"}, {"verse_key": "55:42", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:43", "text_uthmani": "هٰذِه۪ جَهَنَّمُ الَّت۪ي يُكَذِّبُ بِهَا الْمُجْرِمُونَۢ"}, {"verse_key": "55:44", "text_uthmani": "يَطُوفُونَ بَيْنَهَا وَبَيْنَ حَم۪يمٍ اٰنٍۚ"}, {"verse_key": "55:45", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ۟"}, {"verse_key": "55:46", "text_uthmani": "وَلِمَنْ خَافَ مَقَامَ رَبِّه۪ جَنَّتَانِۚ"}, {"verse_key": "55:47", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۙ"}, {"verse_key": "55:48", "text_uthmani": "ذَوَاتَٓا اَفْنَانٍۚ"}, {"verse_key": "55:49", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:50", "text_uthmani": "ف۪يهِمَا عَيْنَانِ تَجْرِيَانِۚ"}, {"verse_key": "55:51", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:52", "text_uthmani": "ف۪يهِمَا مِنْ كُلِّ فَاكِهَةٍ زَوْجَانِۚ"}, {"verse_key": "55:53", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:54", "text_uthmani": "مُتَّكِـ۪ٔينَ عَلٰى فُرُشٍ بَطَٓائِنُهَا مِنْ اِسْتَبْرَقٍۜ وَجَنَا الْجَنَّتَيْنِ دَانٍۚ"}, {"verse_key": "55:55", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:56", "text_uthmani": "ف۪يهِنَّ قَاصِرَاتُ الطَّرْفِۙ لَمْ يَطْمِثْهُنَّ اِنْسٌ قَبْلَهُمْ وَلَا جَٓانٌّۚ"}, {"verse_key": "55:57", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۚ"}, {"verse_key": "55:58", "text_uthmani": "كَاَنَّهُنَّ الْيَاقُوتُ وَالْمَرْجَانُۚ"}, {"verse_key": "55:59", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:60", "text_uthmani": "هَلْ جَزَٓاءُ الْاِحْسَانِ اِلَّا الْاِحْسَانُۚ"}, {"verse_key": "55:61", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:62", "text_uthmani": "وَمِنْ دُونِهِمَا جَنَّتَانِۚ"}, {"verse_key": "55:63", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۙ"}, {"verse_key": "55:64", "text_uthmani": "مُدْهَٓامَّتَانِۚ"}, {"verse_key": "55:65", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۚ"}, {"verse_key": "55:66", "text_uthmani": "ف۪يهِمَا عَيْنَانِ نَضَّاخَتَانِۚ"}, {"verse_key": "55:67", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۚ"}, {"verse_key": "55:68", "text_uthmani": "ف۪يهِمَا فَاكِهَةٌ وَنَخْلٌ وَرُمَّانٌۚ"}, {"verse_key": "55:69", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۚ"}, {"verse_key": "55:70", "text_uthmani": "ف۪يهِنَّ خَيْرَاتٌ حِسَانٌۚ"}, {"verse_key": "55:71", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۚ"}, {"verse_key": "55:72", "text_uthmani": "حُورٌ مَقْصُورَاتٌ فِي الْخِيَامِۚ"}, {"verse_key": "55:73", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۚ"}, {"verse_key": "55:74", "text_uthmani": "لَمْ يَطْمِثْهُنَّ اِنْسٌ قَبْلَهُمْ وَلَا جَٓانٌّۚ"}, {"verse_key": "55:75", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِۚ"}, {"verse_key": "55:76", "text_uthmani": "مُتَّكِـ۪ٔينَ عَلٰى رَفْرَفٍ خُضْرٍ وَعَبْقَرِيٍّ حِسَانٍۚ"}, {"verse_key": "55:77", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكُمَا تُكَذِّبَانِ"}, {"verse_key": "55:78", "text_uthmani": "تَبَارَكَ اسْمُ رَبِّكَ ذِي الْجَلَالِ وَالْاِكْرَامِ"}]}