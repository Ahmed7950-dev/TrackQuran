{"verses": [{"verse_key": "107:1", "text_uthmani": "اَرَاَيْتَ الَّذ۪ي يُكَذِّبُ بِالدّ۪ينِۜ"}, {"verse_key": "107:2", "text_uthmani": "فَذٰلِكَ الَّذ۪ي يَدُعُّ الْيَت۪يمَۙ"}, {"verse_key": "107:3", "text_uthmani": "وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْك۪ينِۜ"}, {"verse_key": "107:4", "text_uthmani": "فَوَيْلٌ لِلْمُصَلّ۪ينَۙ"}, {"verse_key": "107:5", "text_uthmani": "اَلَّذ۪ينَ هُمْ عَنْ صَلَاتِهِمْ سَاهُونَۙ"}, {"verse_key": "107:6", "text_uthmani": "اَلَّذ۪ينَ هُمْ يُرَٓاؤُ۫نَۙ"}, {"verse_key": "107:7", "text_uthmani": "وَيَمْنَعُونَ الْمَاعُونَ"}]}