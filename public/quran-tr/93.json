{"verses": [{"verse_key": "93:1", "text_uthmani": "وَالضُّحٰىۙ"}, {"verse_key": "93:2", "text_uthmani": "وَالَّيْلِ اِذَا سَجٰىۙ"}, {"verse_key": "93:3", "text_uthmani": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰىۜ"}, {"verse_key": "93:4", "text_uthmani": "وَلَلْاٰخِرَةُ خَيْرٌ لَكَ مِنَ الْاُو۫لٰىۜ"}, {"verse_key": "93:5", "text_uthmani": "وَلَسَوْفَ يُعْط۪يكَ رَبُّكَ فَتَرْضٰىۜ"}, {"verse_key": "93:6", "text_uthmani": "اَلَمْ يَجِدْكَ يَت۪يمًا فَاٰوٰىۖ"}, {"verse_key": "93:7", "text_uthmani": "وَوَجَدَكَ ضَٓالًّا فَهَدٰىۖ"}, {"verse_key": "93:8", "text_uthmani": "وَوَجَدَكَ عَٓائِلًا فَاَغْنٰىۜ"}, {"verse_key": "93:9", "text_uthmani": "فَاَمَّا الْيَت۪يمَ فَلَا تَقْهَرْۜ"}, {"verse_key": "93:10", "text_uthmani": "وَاَمَّا السَّٓائِلَ فَلَا تَنْهَرْۜ"}, {"verse_key": "93:11", "text_uthmani": "وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ"}]}