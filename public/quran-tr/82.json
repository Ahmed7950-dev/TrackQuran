{"verses": [{"verse_key": "82:1", "text_uthmani": "اِذَا السَّمَٓاءُ انْفَطَرَتْۙ"}, {"verse_key": "82:2", "text_uthmani": "وَاِذَا الْكَوَاكِبُ انْتَثَرَتْۙ"}, {"verse_key": "82:3", "text_uthmani": "وَاِذَا الْبِحَارُ فُجِّرَتْۙ"}, {"verse_key": "82:4", "text_uthmani": "وَاِذَا الْقُبُورُ بُعْثِرَتْۙ"}, {"verse_key": "82:5", "text_uthmani": "عَلِمَتْ نَفْسٌ مَا قَدَّمَتْ وَاَخَّرَتْۜ"}, {"verse_key": "82:6", "text_uthmani": "يَٓا اَيُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَر۪يمِۙ"}, {"verse_key": "82:7", "text_uthmani": "اَلَّذ۪ي خَلَقَكَ فَسَوّٰيكَ فَعَدَلَكَۙ"}, {"verse_key": "82:8", "text_uthmani": "ف۪ٓي اَيِّ صُورَةٍ مَا شَٓاءَ رَكَّبَكَۜ"}, {"verse_key": "82:9", "text_uthmani": "كَلَّا بَلْ تُكَذِّبُونَ بِالدّ۪ينِۙ"}, {"verse_key": "82:10", "text_uthmani": "وَاِنَّ عَلَيْكُمْ لَحَافِظ۪ينَۙ"}, {"verse_key": "82:11", "text_uthmani": "كِرَامًا كَاتِب۪ينَۙ"}, {"verse_key": "82:12", "text_uthmani": "يَعْلَمُونَ مَا تَفْعَلُونَ"}, {"verse_key": "82:13", "text_uthmani": "اِنَّ الْاَبْرَارَ لَف۪ي نَع۪يمٍۚ"}, {"verse_key": "82:14", "text_uthmani": "وَاِنَّ الْفُجَّارَ لَف۪ي جَح۪يمٍۚ"}, {"verse_key": "82:15", "text_uthmani": "يَصْلَوْنَهَا يَوْمَ الدّ۪ينِ"}, {"verse_key": "82:16", "text_uthmani": "وَمَا هُمْ عَنْهَا بِغَٓائِب۪ينَۜ"}, {"verse_key": "82:17", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۙ"}, {"verse_key": "82:18", "text_uthmani": "ثُمَّ مَٓا اَدْرٰيكَ مَا يَوْمُ الدّ۪ينِۜ"}, {"verse_key": "82:19", "text_uthmani": "يَوْمَ لَا تَمْلِكُ نَفْسٌ لِنَفْسٍ شَيْـًٔاۜ وَالْاَمْرُ يَوْمَئِذٍ لِلّٰهِ"}]}