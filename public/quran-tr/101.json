{"verses": [{"verse_key": "101:1", "text_uthmani": "اَلْقَارِعَةُۙ"}, {"verse_key": "101:2", "text_uthmani": "مَا الْقَارِعَةُۚ"}, {"verse_key": "101:3", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا الْقَارِعَةُۜ"}, {"verse_key": "101:4", "text_uthmani": "يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِۙ"}, {"verse_key": "101:5", "text_uthmani": "وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِۜ"}, {"verse_key": "101:6", "text_uthmani": "فَاَمَّا مَنْ ثَقُلَتْ مَوَاز۪ينُهُۙ"}, {"verse_key": "101:7", "text_uthmani": "فَهُوَ ف۪ي ع۪يشَةٍ رَاضِيَةٍۜ"}, {"verse_key": "101:8", "text_uthmani": "وَاَمَّا مَنْ خَفَّتْ مَوَاز۪ينُهُۙ"}, {"verse_key": "101:9", "text_uthmani": "فَاُمُّهُ هَاوِيَةٌۜ"}, {"verse_key": "101:10", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا هِيَهْۜ"}, {"verse_key": "101:11", "text_uthmani": "نَارٌ حَامِيَةٌ"}]}