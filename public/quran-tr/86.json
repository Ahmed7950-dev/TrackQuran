{"verses": [{"verse_key": "86:1", "text_uthmani": "وَالسَّمَٓاءِ وَالطَّارِقِۙ"}, {"verse_key": "86:2", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا الطَّارِقُۙ"}, {"verse_key": "86:3", "text_uthmani": "اَلنَّجْمُ الثَّاقِبُۙ"}, {"verse_key": "86:4", "text_uthmani": "اِنْ كُلُّ نَفْسٍ لَمَّا عَلَيْهَا حَافِظٌۜ"}, {"verse_key": "86:5", "text_uthmani": "فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَۜ"}, {"verse_key": "86:6", "text_uthmani": "خُلِقَ مِنْ مَٓاءٍ دَافِقٍۙ"}, {"verse_key": "86:7", "text_uthmani": "يَخْرُجُ مِنْ بَيْنِ الصُّلْبِ وَالتَّرَٓائِبِۜ"}, {"verse_key": "86:8", "text_uthmani": "اِنَّهُ عَلٰى رَجْعِه۪ لَقَادِرٌۜ"}, {"verse_key": "86:9", "text_uthmani": "يَوْمَ تُبْلَى السَّرَٓائِرُۙ"}, {"verse_key": "86:10", "text_uthmani": "فَمَا لَهُ مِنْ قُوَّةٍ وَلَا نَاصِرٍۜ"}, {"verse_key": "86:11", "text_uthmani": "وَالسَّمَٓاءِ ذَاتِ الرَّجْعِۙ"}, {"verse_key": "86:12", "text_uthmani": "وَالْاَرْضِ ذَاتِ الصَّدْعِۙ"}, {"verse_key": "86:13", "text_uthmani": "اِنَّهُ لَقَوْلٌ فَصْلٌۙ"}, {"verse_key": "86:14", "text_uthmani": "وَمَا هُوَ بِالْهَزْلِۜ"}, {"verse_key": "86:15", "text_uthmani": "اِنَّهُمْ يَك۪يدُونَ كَيْدًاۙ"}, {"verse_key": "86:16", "text_uthmani": "وَاَك۪يدُ كَيْدًاۚ"}, {"verse_key": "86:17", "text_uthmani": "فَمَهِّلِ الْكَافِر۪ينَ اَمْهِلْهُمْ رُوَيْدًا"}]}