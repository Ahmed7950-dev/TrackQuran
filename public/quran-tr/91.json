{"verses": [{"verse_key": "91:1", "text_uthmani": "وَالشَّمْسِ وَضُحٰيهَاۙۖ"}, {"verse_key": "91:2", "text_uthmani": "وَالْقَمَرِ اِذَا تَلٰيهَاۙۖ"}, {"verse_key": "91:3", "text_uthmani": "وَالنَّهَارِ اِذَا جَلّٰيهَاۙۖ"}, {"verse_key": "91:4", "text_uthmani": "وَالَّيْلِ اِذَا يَغْشٰيهَاۙۖ"}, {"verse_key": "91:5", "text_uthmani": "وَالسَّمَٓاءِ وَمَا بَنٰيهَاۙۖ"}, {"verse_key": "91:6", "text_uthmani": "وَالْاَرْضِ وَمَا طَحٰيهَاۙۖ"}, {"verse_key": "91:7", "text_uthmani": "وَنَفْسٍ وَمَا سَوّٰيهَاۙۖ"}, {"verse_key": "91:8", "text_uthmani": "فَاَلْهَمَهَا فُجُورَهَا وَتَقْوٰيهَاۙۖ"}, {"verse_key": "91:9", "text_uthmani": "قَدْ اَفْلَحَ مَنْ زَكّٰيهَاۙۖ"}, {"verse_key": "91:10", "text_uthmani": "وَقَدْ خَابَ مَنْ دَسّٰيهَاۜ"}, {"verse_key": "91:11", "text_uthmani": "كَذَّبَتْ ثَمُودُ بِطَغْوٰيهَاۙۖ"}, {"verse_key": "91:12", "text_uthmani": "اِذِ انْبَعَثَ اَشْقٰيهَاۙۖ"}, {"verse_key": "91:13", "text_uthmani": "فَقَالَ لَهُمْ رَسُولُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْيٰيهَا۠"}, {"verse_key": "91:14", "text_uthmani": "فَكَذَّبُوهُ فَعَقَرُوهَاۙۖ فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوّٰيهَاۙۖ"}, {"verse_key": "91:15", "text_uthmani": "وَلَا يَخَافُ عُقْبٰيهَا"}]}