{"verses": [{"verse_key": "69:1", "text_uthmani": "اَلْحَٓاقَّةُۙ"}, {"verse_key": "69:2", "text_uthmani": "مَا الْحَٓاقَّةُۚ"}, {"verse_key": "69:3", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا الْحَٓاقَّةُۜ"}, {"verse_key": "69:4", "text_uthmani": "كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ"}, {"verse_key": "69:5", "text_uthmani": "فَاَمَّا ثَمُودُ فَاُهْلِكُوا بِالطَّاغِيَةِ"}, {"verse_key": "69:6", "text_uthmani": "وَاَمَّا عَادٌ فَاُهْلِكُوا بِر۪يحٍ صَرْصَرٍ عَاتِيَةٍۙ"}, {"verse_key": "69:7", "text_uthmani": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَانِيَةَ اَيَّامٍۙ حُسُومًا فَتَرَى الْقَوْمَ ف۪يهَا صَرْعٰىۙ كَاَنَّهُمْ اَعْجَازُ نَخْلٍ خَاوِيَةٍۚ"}, {"verse_key": "69:8", "text_uthmani": "فَهَلْ تَرٰى لَهُمْ مِنْ بَاقِيَةٍ"}, {"verse_key": "69:9", "text_uthmani": "وَجَٓاءَ فِرْعَوْنُ وَمَنْ قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِۚ"}, {"verse_key": "69:10", "text_uthmani": "فَعَصَوْا رَسُولَ رَبِّهِمْ فَاَخَذَهُمْ اَخْذَةً رَابِيَةً"}, {"verse_key": "69:11", "text_uthmani": "اِنَّا لَمَّا طَغَا الْمَٓاءُ حَمَلْنَاكُمْ فِي الْجَارِيَةِۙ"}, {"verse_key": "69:12", "text_uthmani": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَٓا اُذُنٌ وَاعِيَةٌ"}, {"verse_key": "69:13", "text_uthmani": "فَاِذَا نُفِخَ فِي الصُّورِ نَفْخَةٌ وَاحِدَةٌۙ"}, {"verse_key": "69:14", "text_uthmani": "وَحُمِلَتِ الْاَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَاحِدَةً"}, {"verse_key": "69:15", "text_uthmani": "فَيَوْمَئِذٍ وَقَعَتِ الْوَاقِعَةُۙ"}, {"verse_key": "69:16", "text_uthmani": "وَانْشَقَّتِ السَّمَٓاءُ فَهِيَ يَوْمَئِذٍ وَاهِيَةٌۙ"}, {"verse_key": "69:17", "text_uthmani": "وَالْمَلَكُ عَلٰٓى اَرْجَٓائِهَاۜ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌۜ"}, {"verse_key": "69:18", "text_uthmani": "يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفٰى مِنْكُمْ خَافِيَةٌ"}, {"verse_key": "69:19", "text_uthmani": "فَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِيَم۪ينِه۪ فَيَقُولُ هَٓاؤُ۬مُ اقْرَؤُ۫ا كِتَابِيَهْۚ"}, {"verse_key": "69:20", "text_uthmani": "اِنّ۪ي ظَنَنْتُ اَنّ۪ي مُلَاقٍ حِسَابِيَهْۚ"}, {"verse_key": "69:21", "text_uthmani": "فَهُوَ ف۪ي ع۪يشَةٍ رَاضِيَةٍۙ"}, {"verse_key": "69:22", "text_uthmani": "ف۪ي جَنَّةٍ عَالِيَةٍۙ"}, {"verse_key": "69:23", "text_uthmani": "قُطُوفُهَا دَانِيَةٌ"}, {"verse_key": "69:24", "text_uthmani": "كُلُوا وَاشْرَبُوا هَن۪ٓيـًٔا بِمَٓا اَسْلَفْتُمْ فِي الْاَيَّامِ الْخَالِيَةِ"}, {"verse_key": "69:25", "text_uthmani": "وَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِشِمَالِه۪ فَيَقُولُ يَا لَيْتَن۪ي لَمْ اُو۫تَ كِتَابِيَهْۚ"}, {"verse_key": "69:26", "text_uthmani": "وَلَمْ اَدْرِ مَا حِسَابِيَهْۚ"}, {"verse_key": "69:27", "text_uthmani": "يَا لَيْتَهَا كَانَتِ الْقَاضِيَةَۚ"}, {"verse_key": "69:28", "text_uthmani": "مَٓا اَغْنٰى عَنّ۪ي مَالِيَهْۚ"}, {"verse_key": "69:29", "text_uthmani": "هَلَكَ عَنّ۪ي سُلْطَانِيَهْۚ"}, {"verse_key": "69:30", "text_uthmani": "خُذُوهُ فَغُلُّوهُۙ"}, {"verse_key": "69:31", "text_uthmani": "ثُمَّ الْجَح۪يمَ صَلُّوهُۙ"}, {"verse_key": "69:32", "text_uthmani": "ثُمَّ ف۪ي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُۜ"}, {"verse_key": "69:33", "text_uthmani": "اِنَّهُ كَانَ لَا يُؤْمِنُ بِاللّٰهِ الْعَظ۪يمِۙ"}, {"verse_key": "69:34", "text_uthmani": "وَلَا يَحُضُّ عَلٰى طَعَامِ الْمِسْك۪ينِۜ"}, {"verse_key": "69:35", "text_uthmani": "فَلَيْسَ لَهُ الْيَوْمَ هٰهُنَا حَم۪يمٌۙ"}, {"verse_key": "69:36", "text_uthmani": "وَلَا طَعَامٌ اِلَّا مِنْ غِسْل۪ينٍۙ"}, {"verse_key": "69:37", "text_uthmani": "لَا يَأْكُلُهُٓ اِلَّا الْخَاطِؤُ۫نَ۟"}, {"verse_key": "69:38", "text_uthmani": "فَلَٓا اُقْسِمُ بِمَا تُبْصِرُونَۙ"}, {"verse_key": "69:39", "text_uthmani": "وَمَا لَا تُبْصِرُونَۙ"}, {"verse_key": "69:40", "text_uthmani": "اِنَّهُ لَقَوْلُ رَسُولٍ كَر۪يمٍۚ"}, {"verse_key": "69:41", "text_uthmani": "وَمَا هُوَ بِقَوْلِ شَاعِرٍۜ قَل۪يلًا مَا تُؤْمِنُونَۙ"}, {"verse_key": "69:42", "text_uthmani": "وَلَا بِقَوْلِ كَاهِنٍۜ قَل۪يلًا مَا تَذَكَّرُونَۜ"}, {"verse_key": "69:43", "text_uthmani": "تَنْز۪يلٌ مِنْ رَبِّ الْعَالَم۪ينَ"}, {"verse_key": "69:44", "text_uthmani": "وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْاَقَاو۪يلِۙ"}, {"verse_key": "69:45", "text_uthmani": "لَاَخَذْنَا مِنْهُ بِالْيَم۪ينِۙ"}, {"verse_key": "69:46", "text_uthmani": "ثُمَّ لَقَطَعْنَا مِنْهُ الْوَت۪ينَۘ"}, {"verse_key": "69:47", "text_uthmani": "فَمَا مِنْكُمْ مِنْ اَحَدٍ عَنْهُ حَاجِز۪ينَ"}, {"verse_key": "69:48", "text_uthmani": "وَاِنَّهُ لَتَذْكِرَةٌ لِلْمُتَّق۪ينَ"}, {"verse_key": "69:49", "text_uthmani": "وَاِنَّا لَنَعْلَمُ اَنَّ مِنْكُمْ مُكَذِّب۪ينَ"}, {"verse_key": "69:50", "text_uthmani": "وَاِنَّهُ لَحَسْرَةٌ عَلَى الْكَافِر۪ينَ"}, {"verse_key": "69:51", "text_uthmani": "وَاِنَّهُ لَحَقُّ الْيَق۪ينِ"}, {"verse_key": "69:52", "text_uthmani": "فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظ۪يمِ"}]}