{"verses": [{"verse_key": "70:1", "text_uthmani": "سَاَلَ سَٓائِلٌ بِعَذَابٍ وَاقِعٍۙ"}, {"verse_key": "70:2", "text_uthmani": "لِلْكَافِر۪ينَ لَيْسَ لَهُ دَافِعٌۙ"}, {"verse_key": "70:3", "text_uthmani": "مِنَ اللّٰهِ ذِي الْمَعَارِجِۜ"}, {"verse_key": "70:4", "text_uthmani": "تَعْرُجُ الْمَلٰٓئِكَةُ وَالرُّوحُ اِلَيْهِ ف۪ي يَوْمٍ كَانَ مِقْدَارُهُ خَمْس۪ينَ اَلْفَ سَنَةٍۚ"}, {"verse_key": "70:5", "text_uthmani": "فَاصْبِرْ صَبْرًا جَم۪يلًا"}, {"verse_key": "70:6", "text_uthmani": "اِنَّهُمْ يَرَوْنَهُ بَع۪يدًاۙ"}, {"verse_key": "70:7", "text_uthmani": "وَنَرٰيهُ قَر۪يبًاۜ"}, {"verse_key": "70:8", "text_uthmani": "يَوْمَ تَكُونُ السَّمَٓاءُ كَالْمُهْلِۙ"}, {"verse_key": "70:9", "text_uthmani": "وَتَكُونُ الْجِبَالُ كَالْعِهْنِۙ"}, {"verse_key": "70:10", "text_uthmani": "وَلَا يَسْـَٔلُ حَم۪يمٌ حَم۪يمًاۚ"}, {"verse_key": "70:11", "text_uthmani": "يُبَصَّرُونَهُمْۜ يَوَدُّ الْمُجْرِمُ لَوْ يَفْتَد۪ي مِنْ عَذَابِ يَوْمِئِذٍ بِبَن۪يهِۙ"}, {"verse_key": "70:12", "text_uthmani": "وَصَاحِبَتِه۪ وَاَخ۪يهِۙ"}, {"verse_key": "70:13", "text_uthmani": "وَفَص۪يلَتِهِ الَّت۪ي تُـْٔو۪يهِۙ"}, {"verse_key": "70:14", "text_uthmani": "وَمَنْ فِي الْاَرْضِ جَم۪يعًاۙ ثُمَّ يُنْج۪يهِۙ"}, {"verse_key": "70:15", "text_uthmani": "كَلَّاۜ اِنَّهَا لَظٰىۙ"}, {"verse_key": "70:16", "text_uthmani": "نَزَّاعَةً لِلشَّوٰىۚ"}, {"verse_key": "70:17", "text_uthmani": "تَدْعُوا مَنْ اَدْبَرَ وَتَوَلّٰىۙ"}, {"verse_key": "70:18", "text_uthmani": "وَجَمَعَ فَاَوْعٰى"}, {"verse_key": "70:19", "text_uthmani": "اِنَّ الْاِنْسَانَ خُلِقَ هَلُوعًاۙ"}, {"verse_key": "70:20", "text_uthmani": "اِذَا مَسَّهُ الشَّرُّ جَزُوعًاۙ"}, {"verse_key": "70:21", "text_uthmani": "وَاِذَا مَسَّهُ الْخَيْرُ مَنُوعًاۙ"}, {"verse_key": "70:22", "text_uthmani": "اِلَّا الْمُصَلّ۪ينَۙ"}, {"verse_key": "70:23", "text_uthmani": "اَلَّذ۪ينَ هُمْ عَلٰى صَلَاتِهِمْ دَٓائِمُونَۖ"}, {"verse_key": "70:24", "text_uthmani": "وَالَّذ۪ينَ ف۪ٓي اَمْوَالِهِمْ حَقٌّ مَعْلُومٌۙ"}, {"verse_key": "70:25", "text_uthmani": "لِلسَّٓائِلِ وَالْمَحْرُومِۖ"}, {"verse_key": "70:26", "text_uthmani": "وَالَّذ۪ينَ يُصَدِّقُونَ بِيَوْمِ الدّ۪ينِۖ"}, {"verse_key": "70:27", "text_uthmani": "وَالَّذ۪ينَ هُمْ مِنْ عَذَابِ رَبِّهِمْ مُشْفِقُونَۚ"}, {"verse_key": "70:28", "text_uthmani": "اِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَأْمُونٍۚ"}, {"verse_key": "70:29", "text_uthmani": "وَالَّذ۪ينَ هُمْ لِفُرُوجِهِمْ حَافِظُونَۙ"}, {"verse_key": "70:30", "text_uthmani": "اِلَّا عَلٰٓى اَزْوَاجِهِمْ اَوْ مَا مَلَكَتْ اَيْمَانُهُمْ فَاِنَّهُمْ غَيْرُ مَلُوم۪ينَۚ"}, {"verse_key": "70:31", "text_uthmani": "فَمَنِ ابْتَغٰى وَرَٓاءَ ذٰلِكَ فَاُو۬لٰٓئِكَ هُمُ الْعَادُونَۚ"}, {"verse_key": "70:32", "text_uthmani": "وَالَّذ۪ينَ هُمْ لِاَمَانَاتِهِمْ وَعَهْدِهِمْ رَاعُونَۖ"}, {"verse_key": "70:33", "text_uthmani": "وَالَّذ۪ينَ هُمْ بِشَهَادَاتِهِمْ قَٓائِمُونَۖ"}, {"verse_key": "70:34", "text_uthmani": "وَالَّذ۪ينَ هُمْ عَلٰى صَلَاتِهِمْ يُحَافِظُونَۜ"}, {"verse_key": "70:35", "text_uthmani": "اُو۬لٰٓئِكَ ف۪ي جَنَّاتٍ مُكْرَمُونَۜ۟"}, {"verse_key": "70:36", "text_uthmani": "فَمَا لِ‌الَّذ۪ينَ كَفَرُوا قِبَلَكَ مُهْطِع۪ينَۙ"}, {"verse_key": "70:37", "text_uthmani": "عَنِ الْيَم۪ينِۙ وَعَنِ الشِّمَالِ عِز۪ينَ"}, {"verse_key": "70:38", "text_uthmani": "اَيَطْمَعُ كُلُّ امْرِئٍ مِنْهُمْ اَنْ يُدْخَلَ جَنَّةَ نَع۪يمٍۙ"}, {"verse_key": "70:39", "text_uthmani": "كَلَّاۜ اِنَّا خَلَقْنَاهُمْ مِمَّا يَعْلَمُونَ"}, {"verse_key": "70:40", "text_uthmani": "فَلَٓا اُقْسِمُ بِرَبِّ الْمَشَارِقِ وَالْمَغَارِبِ اِنَّا لَقَادِرُونَۙ"}, {"verse_key": "70:41", "text_uthmani": "عَلٰٓى اَنْ نُبَدِّلَ خَيْرًا مِنْهُمْۙ وَمَا نَحْنُ بِمَسْبُوق۪ينَ"}, {"verse_key": "70:42", "text_uthmani": "فَذَرْهُمْ يَخُوضُوا وَيَلْعَبُوا حَتّٰى يُلَاقُوا يَوْمَهُمُ الَّذ۪ي يُوعَدُونَۙ"}, {"verse_key": "70:43", "text_uthmani": "يَوْمَ يَخْرُجُونَ مِنَ الْاَجْدَاثِ سِرَاعًا كَاَنَّهُمْ اِلٰى نُصُبٍ يُوفِضُونَۙ"}, {"verse_key": "70:44", "text_uthmani": "خَاشِعَةً اَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌۜ ذٰلِكَ الْيَوْمُ الَّذ۪ي كَانُوا يُوعَدُونَ"}]}