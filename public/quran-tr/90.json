{"verses": [{"verse_key": "90:1", "text_uthmani": "لَٓا اُقْسِمُ بِهٰذَا الْبَلَدِۙ"}, {"verse_key": "90:2", "text_uthmani": "وَاَنْتَ حِلٌّ بِهٰذَا الْبَلَدِۙ"}, {"verse_key": "90:3", "text_uthmani": "وَوَالِدٍ وَمَا وَلَدَۙ"}, {"verse_key": "90:4", "text_uthmani": "لَقَدْ خَلَقْنَا الْاِنْسَانَ ف۪ي كَبَدٍۜ"}, {"verse_key": "90:5", "text_uthmani": "اَيَحْسَبُ اَنْ لَنْ يَقْدِرَ عَلَيْهِ اَحَدٌۢ"}, {"verse_key": "90:6", "text_uthmani": "يَقُولُ اَهْلَكْتُ مَالًا لُبَدًاۜ"}, {"verse_key": "90:7", "text_uthmani": "اَيَحْسَبُ اَنْ لَمْ يَرَهُٓ اَحَدٌۜ"}, {"verse_key": "90:8", "text_uthmani": "اَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِۙ"}, {"verse_key": "90:9", "text_uthmani": "وَلِسَانًا وَشَفَتَيْنِۙ"}, {"verse_key": "90:10", "text_uthmani": "وَهَدَيْنَاهُ النَّجْدَيْنِۚ"}, {"verse_key": "90:11", "text_uthmani": "فَلَا اقْتَحَمَ الْعَقَبَةَۘ"}, {"verse_key": "90:12", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا الْعَقَبَةُۜ"}, {"verse_key": "90:13", "text_uthmani": "فَكُّ رَقَبَةٍۙ"}, {"verse_key": "90:14", "text_uthmani": "اَوْ اِطْعَامٌ ف۪ي يَوْمٍ ذ۪ي مَسْغَبَةٍۙ"}, {"verse_key": "90:15", "text_uthmani": "يَت۪يمًا ذَا مَقْرَبَةٍۙ"}, {"verse_key": "90:16", "text_uthmani": "اَوْ مِسْك۪ينًا ذَا مَتْرَبَةٍۜ"}, {"verse_key": "90:17", "text_uthmani": "ثُمَّ كَانَ مِنَ الَّذ۪ينَ اٰمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِۜ"}, {"verse_key": "90:18", "text_uthmani": "اُو۬لٰٓئِكَ اَصْحَابُ الْمَيْمَنَةِۜ"}, {"verse_key": "90:19", "text_uthmani": "وَالَّذ۪ينَ كَفَرُوا بِاٰيَاتِنَا هُمْ اَصْحَابُ الْمَشْـَٔمَةِۜ"}, {"verse_key": "90:20", "text_uthmani": "عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ"}]}