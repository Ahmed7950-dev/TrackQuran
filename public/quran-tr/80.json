{"verses": [{"verse_key": "80:1", "text_uthmani": "عَبَسَ وَتَوَلّٰىۙ"}, {"verse_key": "80:2", "text_uthmani": "اَنْ جَٓاءَهُ الْاَعْمٰىۜ"}, {"verse_key": "80:3", "text_uthmani": "وَمَا يُدْر۪يكَ لَعَلَّهُ يَزَّكّٰىۙ"}, {"verse_key": "80:4", "text_uthmani": "اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰىۜ"}, {"verse_key": "80:5", "text_uthmani": "اَمَّا مَنِ اسْتَغْنٰىۙ"}, {"verse_key": "80:6", "text_uthmani": "فَاَنْتَ لَهُ تَصَدّٰىۜ"}, {"verse_key": "80:7", "text_uthmani": "وَمَا عَلَيْكَ اَلَّا يَزَّكّٰىۜ"}, {"verse_key": "80:8", "text_uthmani": "وَاَمَّا مَنْ جَٓاءَكَ يَسْعٰىۙ"}, {"verse_key": "80:9", "text_uthmani": "وَهُوَ يَخْشٰىۙ"}, {"verse_key": "80:10", "text_uthmani": "فَاَنْتَ عَنْهُ تَلَهّٰىۚ"}, {"verse_key": "80:11", "text_uthmani": "كَلَّٓا اِنَّهَا تَذْكِرَةٌۚ"}, {"verse_key": "80:12", "text_uthmani": "فَمَنْ شَٓاءَ ذَكَرَهُۢ"}, {"verse_key": "80:13", "text_uthmani": "ف۪ي صُحُفٍ مُكَرَّمَةٍۙ"}, {"verse_key": "80:14", "text_uthmani": "مَرْفُوعَةٍ مُطَهَّرَةٍۙ"}, {"verse_key": "80:15", "text_uthmani": "بِاَيْد۪ي سَفَرَةٍۙ"}, {"verse_key": "80:16", "text_uthmani": "كِرَامٍ بَرَرَةٍۜ"}, {"verse_key": "80:17", "text_uthmani": "قُتِلَ الْاِنْسَانُ مَٓا اَكْفَرَهُۜ"}, {"verse_key": "80:18", "text_uthmani": "مِنْ اَيِّ شَيْءٍ خَلَقَهُۜ"}, {"verse_key": "80:19", "text_uthmani": "مِنْ نُطْفَةٍۜ خَلَقَهُ فَقَدَّرَهُۙ"}, {"verse_key": "80:20", "text_uthmani": "ثُمَّ السَّب۪يلَ يَسَّرَهُۙ"}, {"verse_key": "80:21", "text_uthmani": "ثُمَّ اَمَاتَهُ فَاَقْبَرَهُۙ"}, {"verse_key": "80:22", "text_uthmani": "ثُمَّ اِذَا شَٓاءَ اَنْشَرَهُ"}, {"verse_key": "80:23", "text_uthmani": "كَلَّا لَمَّا يَقْضِ مَٓا اَمَرَهُۙ"}, {"verse_key": "80:24", "text_uthmani": "فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِه۪ۙ"}, {"verse_key": "80:25", "text_uthmani": "اَنَّا صَبَبْنَا الْمَٓاءَ صَبًّاۙ"}, {"verse_key": "80:26", "text_uthmani": "ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّاۙ"}, {"verse_key": "80:27", "text_uthmani": "فَاَنْبَتْنَا ف۪يهَا حَبًّاۙ"}, {"verse_key": "80:28", "text_uthmani": "وَعِنَبًا وَقَضْبًاۙ"}, {"verse_key": "80:29", "text_uthmani": "وَزَيْتُونًا وَنَخْلًاۙ"}, {"verse_key": "80:30", "text_uthmani": "وَحَدَٓائِقَ غُلْبًاۙ"}, {"verse_key": "80:31", "text_uthmani": "وَفَاكِهَةً وَاَبًّاۙ"}, {"verse_key": "80:32", "text_uthmani": "مَتَاعًا لَكُمْ وَلِاَنْعَامِكُمْۜ"}, {"verse_key": "80:33", "text_uthmani": "فَاِذَا جَٓاءَتِ الصَّٓاخَّةُۘ"}, {"verse_key": "80:34", "text_uthmani": "يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخ۪يهِۙ"}, {"verse_key": "80:35", "text_uthmani": "وَاُمِّهِ وَاَب۪يهِۙ"}, {"verse_key": "80:36", "text_uthmani": "وَصَاحِبَتِه۪ وَبَن۪يهِۜ"}, {"verse_key": "80:37", "text_uthmani": "لِكُلِّ امْرِئٍ مِنْهُمْ يَوْمَئِذٍ شَأْنٌ يُغْن۪يهِۜ"}, {"verse_key": "80:38", "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ مُسْفِرَةٌۙ"}, {"verse_key": "80:39", "text_uthmani": "ضَاحِكَةٌ مُسْتَبْشِرَةٌۚ"}, {"verse_key": "80:40", "text_uthmani": "وَوُجُوهٌ يَوْمَئِذٍ عَلَيْهَا غَبَرَةٌۙ"}, {"verse_key": "80:41", "text_uthmani": "تَرْهَقُهَا قَتَرَةٌۜ"}, {"verse_key": "80:42", "text_uthmani": "اُو۬لٰٓئِكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ"}]}