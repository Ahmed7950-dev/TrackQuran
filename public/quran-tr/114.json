{"verses": [{"verse_key": "114:1", "text_uthmani": "قُلْ اَعُوذُ بِرَبِّ النَّاسِۙ"}, {"verse_key": "114:2", "text_uthmani": "مَلِكِ النَّاسِۙ"}, {"verse_key": "114:3", "text_uthmani": "اِلٰهِ النَّاسِۙ"}, {"verse_key": "114:4", "text_uthmani": "مِنْ شَرِّ الْوَسْوَاسِ الْخَنَّاسِۙ"}, {"verse_key": "114:5", "text_uthmani": "اَلَّذ۪ي يُوَسْوِسُ ف۪ي صُدُورِ النَّاسِۙ"}, {"verse_key": "114:6", "text_uthmani": "مِنَ الْجِنَّةِ وَالنَّاسِ"}]}