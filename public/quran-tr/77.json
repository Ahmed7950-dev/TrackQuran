{"verses": [{"verse_key": "77:1", "text_uthmani": "وَالْمُرْسَلَاتِ عُرْفًاۙ"}, {"verse_key": "77:2", "text_uthmani": "فَالْعَاصِفَاتِ عَصْفًاۙ"}, {"verse_key": "77:3", "text_uthmani": "وَالنَّاشِرَاتِ نَشْرًاۙ"}, {"verse_key": "77:4", "text_uthmani": "فَالْفَارِقَاتِ فَرْقًاۙ"}, {"verse_key": "77:5", "text_uthmani": "فَالْمُلْقِيَاتِ ذِكْرًاۙ"}, {"verse_key": "77:6", "text_uthmani": "عُذْرًا اَوْ نُذْرًاۙ"}, {"verse_key": "77:7", "text_uthmani": "اِنَّمَا تُوعَدُونَ لَوَاقِعٌۜ"}, {"verse_key": "77:8", "text_uthmani": "فَاِذَا النُّجُومُ طُمِسَتْۙ"}, {"verse_key": "77:9", "text_uthmani": "وَاِذَا السَّمَٓاءُ فُرِجَتْۙ"}, {"verse_key": "77:10", "text_uthmani": "وَاِذَا الْجِبَالُ نُسِفَتْۙ"}, {"verse_key": "77:11", "text_uthmani": "وَاِذَا الرُّسُلُ اُقِّتَتْۜ"}, {"verse_key": "77:12", "text_uthmani": "لِاَيِّ يَوْمٍ اُجِّلَتْۜ"}, {"verse_key": "77:13", "text_uthmani": "لِيَوْمِ الْفَصْلِۚ"}, {"verse_key": "77:14", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا يَوْمُ الْفَصْلِۜ"}, {"verse_key": "77:15", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:16", "text_uthmani": "اَلَمْ نُهْلِكِ الْاَوَّل۪ينَۜ"}, {"verse_key": "77:17", "text_uthmani": "ثُمَّ نُتْبِعُهُمُ الْاٰخِر۪ينَ"}, {"verse_key": "77:18", "text_uthmani": "كَذٰلِكَ نَفْعَلُ بِالْمُجْرِم۪ينَ"}, {"verse_key": "77:19", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:20", "text_uthmani": "اَلَمْ نَخْلُقْكُمْ مِنْ مَٓاءٍ مَه۪ينٍۙ"}, {"verse_key": "77:21", "text_uthmani": "فَجَعَلْنَاهُ ف۪ي قَرَارٍ مَك۪ينٍۙ"}, {"verse_key": "77:22", "text_uthmani": "اِلٰى قَدَرٍ مَعْلُومٍۙ"}, {"verse_key": "77:23", "text_uthmani": "فَقَدَرْنَاۗ فَنِعْمَ الْقَادِرُونَ"}, {"verse_key": "77:24", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:25", "text_uthmani": "اَلَمْ نَجْعَلِ الْاَرْضَ كِفَاتًاۙ"}, {"verse_key": "77:26", "text_uthmani": "اَحْيَٓاءً وَاَمْوَاتًاۙ"}, {"verse_key": "77:27", "text_uthmani": "وَجَعَلْنَا ف۪يهَا رَوَاسِيَ شَامِخَاتٍ وَاَسْقَيْنَاكُمْ مَٓاءً فُرَاتًاۜ"}, {"verse_key": "77:28", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:29", "text_uthmani": "اِنْطَلِقُٓوا اِلٰى مَا كُنْتُمْ بِه۪ تُكَذِّبُونَۚ"}, {"verse_key": "77:30", "text_uthmani": "اِنْطَلِقُٓوا اِلٰى ظِلٍّ ذ۪ي ثَلٰثِ شُعَبٍۙ"}, {"verse_key": "77:31", "text_uthmani": "لَا ظَل۪يلٍ وَلَا يُغْن۪ي مِنَ اللَّهَبِۜ"}, {"verse_key": "77:32", "text_uthmani": "اِنَّهَا تَرْم۪ي بِشَرَرٍ كَالْقَصْرِۚ"}, {"verse_key": "77:33", "text_uthmani": "كَاَنَّهُ جِمَالَتٌ صُفْرٌۜ"}, {"verse_key": "77:34", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:35", "text_uthmani": "هٰذَا يَوْمُ لَا يَنْطِقُونَۙ"}, {"verse_key": "77:36", "text_uthmani": "وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ"}, {"verse_key": "77:37", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:38", "text_uthmani": "هٰذَا يَوْمُ الْفَصْلِۚ جَمَعْنَاكُمْ وَالْاَوَّل۪ينَ"}, {"verse_key": "77:39", "text_uthmani": "فَاِنْ كَانَ لَكُمْ كَيْدٌ فَك۪يدُونِ"}, {"verse_key": "77:40", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ۟"}, {"verse_key": "77:41", "text_uthmani": "اِنَّ الْمُتَّق۪ينَ ف۪ي ظِلَالٍ وَعُيُونٍۙ"}, {"verse_key": "77:42", "text_uthmani": "وَفَوَاكِهَ مِمَّا يَشْتَهُونَۜ"}, {"verse_key": "77:43", "text_uthmani": "كُلُوا وَاشْرَبُوا هَن۪ٓيـًٔا بِمَا كُنْتُمْ تَعْمَلُونَ"}, {"verse_key": "77:44", "text_uthmani": "اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِن۪ينَ"}, {"verse_key": "77:45", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:46", "text_uthmani": "كُلُوا وَتَمَتَّعُوا قَل۪يلًا اِنَّكُمْ مُجْرِمُونَ"}, {"verse_key": "77:47", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:48", "text_uthmani": "وَاِذَا ق۪يلَ لَهُمُ ارْكَعُوا لَا يَرْكَعُونَ"}, {"verse_key": "77:49", "text_uthmani": "وَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّب۪ينَ"}, {"verse_key": "77:50", "text_uthmani": "فَبِاَيِّ حَد۪يثٍ بَعْدَهُ يُؤْمِنُونَ"}]}