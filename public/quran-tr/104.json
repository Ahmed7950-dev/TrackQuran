{"verses": [{"verse_key": "104:1", "text_uthmani": "وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍۙ"}, {"verse_key": "104:2", "text_uthmani": "اَلَّذ۪ي جَمَعَ مَالًا وَعَدَّدَهُۙ"}, {"verse_key": "104:3", "text_uthmani": "يَحْسَبُ اَنَّ مَالَهُٓ اَخْلَدَهُۚ"}, {"verse_key": "104:4", "text_uthmani": "كَلَّا لَيُنْبَذَنَّ فِي الْحُطَمَةِۘ"}, {"verse_key": "104:5", "text_uthmani": "وَمَٓا اَدْرٰيكَ مَا الْحُطَمَةُۜ"}, {"verse_key": "104:6", "text_uthmani": "نَارُ اللّٰهِ الْمُوقَدَةُۙ"}, {"verse_key": "104:7", "text_uthmani": "اَلَّت۪ي تَطَّلِعُ عَلَى الْاَفْـِٔدَةِۜ"}, {"verse_key": "104:8", "text_uthmani": "اِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌۙ"}, {"verse_key": "104:9", "text_uthmani": "ف۪ي عَمَدٍ مُمَدَّدَةٍ"}]}