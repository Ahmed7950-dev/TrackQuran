{"verses": [{"verse_key": "56:1", "text_uthmani": "اِذَا وَقَعَتِ الْوَاقِعَةُۙ"}, {"verse_key": "56:2", "text_uthmani": "لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌۢ"}, {"verse_key": "56:3", "text_uthmani": "خَافِضَةٌ رَافِعَةٌۙ"}, {"verse_key": "56:4", "text_uthmani": "اِذَا رُجَّتِ الْاَرْضُ رَجًّاۙ"}, {"verse_key": "56:5", "text_uthmani": "وَبُسَّتِ الْجِبَالُ بَسًّاۙ"}, {"verse_key": "56:6", "text_uthmani": "فَكَانَتْ هَبَٓاءً مُنْبَثًّاۙ"}, {"verse_key": "56:7", "text_uthmani": "وَكُنْتُمْ اَزْوَاجًا ثَلٰثَةًۜ"}, {"verse_key": "56:8", "text_uthmani": "فَاَصْحَابُ الْمَيْمَنَةِ مَٓا اَصْحَابُ الْمَيْمَنَةِۜ"}, {"verse_key": "56:9", "text_uthmani": "وَاَصْحَابُ الْمَشْـَٔمَةِ مَٓا اَصْحَابُ الْمَشْـَٔمَةِۜ"}, {"verse_key": "56:10", "text_uthmani": "وَالسَّابِقُونَ السَّابِقُونَۙ"}, {"verse_key": "56:11", "text_uthmani": "اُو۬لٰٓئِكَ الْمُقَرَّبُونَۚ"}, {"verse_key": "56:12", "text_uthmani": "ف۪ي جَنَّاتِ النَّع۪يمِ"}, {"verse_key": "56:13", "text_uthmani": "ثُلَّةٌ مِنَ الْاَوَّل۪ينَۙ"}, {"verse_key": "56:14", "text_uthmani": "وَقَل۪يلٌ مِنَ الْاٰخِر۪ينَۜ"}, {"verse_key": "56:15", "text_uthmani": "عَلٰى سُرُرٍ مَوْضُونَةٍۙ"}, {"verse_key": "56:16", "text_uthmani": "مُتَّكِـ۪ٔينَ عَلَيْهَا مُتَقَابِل۪ينَ"}, {"verse_key": "56:17", "text_uthmani": "يَطُوفُ عَلَيْهِمْ وِلْدَانٌ مُخَلَّدُونَۙ"}, {"verse_key": "56:18", "text_uthmani": "بِاَكْوَابٍ وَاَبَار۪يقَ وَكَأْسٍ مِنْ مَع۪ينٍۙ"}, {"verse_key": "56:19", "text_uthmani": "لَا يُصَدَّعُونَ عَنْهَا وَلَا يُنْزِفُونَۙ"}, {"verse_key": "56:20", "text_uthmani": "وَفَاكِهَةٍ مِمَّا يَتَخَيَّرُونَۙ"}, {"verse_key": "56:21", "text_uthmani": "وَلَحْمِ طَيْرٍ مِمَّا يَشْتَهُونَۜ"}, {"verse_key": "56:22", "text_uthmani": "وَحُورٌ ع۪ينٌۙ"}, {"verse_key": "56:23", "text_uthmani": "كَاَمْثَالِ اللُّؤْلُؤِ۬ الْمَكْنُونِۚ"}, {"verse_key": "56:24", "text_uthmani": "جَزَٓاءً بِمَا كَانُوا يَعْمَلُونَ"}, {"verse_key": "56:25", "text_uthmani": "لَا يَسْمَعُونَ ف۪يهَا لَغْوًا وَلَا تَأْث۪يمًاۙ"}, {"verse_key": "56:26", "text_uthmani": "اِلَّا ق۪يلًا سَلَامًا سَلَامًا"}, {"verse_key": "56:27", "text_uthmani": "وَاَصْحَابُ الْيَم۪ينِ مَٓا اَصْحَابُ الْيَم۪ينِۜ"}, {"verse_key": "56:28", "text_uthmani": "ف۪ي سِدْرٍ مَخْضُودٍۙ"}, {"verse_key": "56:29", "text_uthmani": "وَطَلْحٍ مَنْضُودٍۙ"}, {"verse_key": "56:30", "text_uthmani": "وَظِلٍّ مَمْدُودٍۙ"}, {"verse_key": "56:31", "text_uthmani": "وَمَٓاءٍ مَسْكُوبٍۙ"}, {"verse_key": "56:32", "text_uthmani": "وَفَاكِهَةٍ كَث۪يرَةٍۙ"}, {"verse_key": "56:33", "text_uthmani": "لَا مَقْطُوعَةٍ وَلَا مَمْنُوعَةٍۙ"}, {"verse_key": "56:34", "text_uthmani": "وَفُرُشٍ مَرْفُوعَةٍۜ"}, {"verse_key": "56:35", "text_uthmani": "اِنَّٓا اَنْشَأْنَاهُنَّ اِنْشَٓاءًۙ"}, {"verse_key": "56:36", "text_uthmani": "فَجَعَلْنَاهُنَّ اَبْكَارًاۙ"}, {"verse_key": "56:37", "text_uthmani": "عُرُبًا اَتْرَابًاۙ"}, {"verse_key": "56:38", "text_uthmani": "لِاَصْحَابِ الْيَم۪ينِۜ۟"}, {"verse_key": "56:39", "text_uthmani": "ثُلَّةٌ مِنَ الْاَوَّل۪ينَۙ"}, {"verse_key": "56:40", "text_uthmani": "وَثُلَّةٌ مِنَ الْاٰخِر۪ينَۜ"}, {"verse_key": "56:41", "text_uthmani": "وَاَصْحَابُ الشِّمَالِۙ مَٓا اَصْحَابُ الشِّمَالِۜ"}, {"verse_key": "56:42", "text_uthmani": "ف۪ي سَمُومٍ وَحَم۪يمٍۙ"}, {"verse_key": "56:43", "text_uthmani": "وَظِلٍّ مِنْ يَحْمُومٍۙ"}, {"verse_key": "56:44", "text_uthmani": "لَا بَارِدٍ وَلَا كَر۪يمٍ"}, {"verse_key": "56:45", "text_uthmani": "اِنَّهُمْ كَانُوا قَبْلَ ذٰلِكَ مُتْرَف۪ينَۚ"}, {"verse_key": "56:46", "text_uthmani": "وَكَانُوا يُصِرُّونَ عَلَى الْحِنْثِ الْعَظ۪يمِۚ"}, {"verse_key": "56:47", "text_uthmani": "وَكَانُوا يَقُولُونَ اَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا ءَاِنَّا لَمَبْعُوثُونَۙ"}, {"verse_key": "56:48", "text_uthmani": "اَوَاٰبَٓاؤُ۬نَا الْاَوَّلُونَ"}, {"verse_key": "56:49", "text_uthmani": "قُلْ اِنَّ الْاَوَّل۪ينَ وَالْاٰخِر۪ينَۙ"}, {"verse_key": "56:50", "text_uthmani": "لَمَجْمُوعُونَ اِلٰى م۪يقَاتِ يَوْمٍ مَعْلُومٍ"}, {"verse_key": "56:51", "text_uthmani": "ثُمَّ اِنَّكُمْ اَيُّهَا الضَّٓالُّونَ الْمُكَذِّبُونَۙ"}, {"verse_key": "56:52", "text_uthmani": "لَاٰكِلُونَ مِنْ شَجَرٍ مِنْ زَقُّومٍۙ"}, {"verse_key": "56:53", "text_uthmani": "فَمَالِؤُ۫نَ مِنْهَا الْبُطُونَۚ"}, {"verse_key": "56:54", "text_uthmani": "فَشَارِبُونَ عَلَيْهِ مِنَ الْحَم۪يمِۚ"}, {"verse_key": "56:55", "text_uthmani": "فَشَارِبُونَ شُرْبَ الْه۪يمِۜ"}, {"verse_key": "56:56", "text_uthmani": "هٰذَا نُزُلُهُمْ يَوْمَ الدّ۪ينِۜ"}, {"verse_key": "56:57", "text_uthmani": "نَحْنُ خَلَقْنَاكُمْ فَلَوْلَا تُصَدِّقُونَ۟"}, {"verse_key": "56:58", "text_uthmani": "اَفَرَاَيْتُمْ مَا تُمْنُونَۜ"}, {"verse_key": "56:59", "text_uthmani": "ءَاَنْتُمْ تَخْلُقُونَهُٓ اَمْ نَحْنُ الْخَالِقُونَ"}, {"verse_key": "56:60", "text_uthmani": "نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوق۪ينَۙ"}, {"verse_key": "56:61", "text_uthmani": "عَلٰٓى اَنْ نُبَدِّلَ اَمْثَالَكُمْ وَنُنْشِئَكُمْ ف۪ي مَا لَا تَعْلَمُونَ"}, {"verse_key": "56:62", "text_uthmani": "وَلَقَدْ عَلِمْتُمُ النَّشْاَةَ الْاُو۫لٰى فَلَوْلَا تَذَكَّرُونَ"}, {"verse_key": "56:63", "text_uthmani": "اَفَرَاَيْتُمْ مَا تَحْرُثُونَۜ"}, {"verse_key": "56:64", "text_uthmani": "ءَاَنْتُمْ تَزْرَعُونَهُٓ اَمْ نَحْنُ الزَّارِعُونَ"}, {"verse_key": "56:65", "text_uthmani": "لَوْ نَشَٓاءُ لَجَعَلْنَاهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُونَ"}, {"verse_key": "56:66", "text_uthmani": "اِنَّا لَمُغْرَمُونَۙ"}, {"verse_key": "56:67", "text_uthmani": "بَلْ نَحْنُ مَحْرُومُونَ"}, {"verse_key": "56:68", "text_uthmani": "اَفَرَاَيْتُمُ الْمَٓاءَ الَّذ۪ي تَشْرَبُونَۜ"}, {"verse_key": "56:69", "text_uthmani": "ءَاَنْتُمْ اَنْزَلْتُمُوهُ مِنَ الْمُزْنِ اَمْ نَحْنُ الْمُنْزِلُونَ"}, {"verse_key": "56:70", "text_uthmani": "لَوْ نَشَٓاءُ جَعَلْنَاهُ اُجَاجًا فَلَوْلَا تَشْكُرُونَ"}, {"verse_key": "56:71", "text_uthmani": "اَفَرَاَيْتُمُ النَّارَ الَّت۪ي تُورُونَۜ"}, {"verse_key": "56:72", "text_uthmani": "ءَاَنْتُمْ اَنْشَأْتُمْ شَجَرَتَهَٓا اَمْ نَحْنُ الْمُنْشِؤُ۫نَ"}, {"verse_key": "56:73", "text_uthmani": "نَحْنُ جَعَلْنَاهَا تَذْكِرَةً وَمَتَاعًا لِلْمُقْو۪ينَۚ"}, {"verse_key": "56:74", "text_uthmani": "فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظ۪يمِ۟"}, {"verse_key": "56:75", "text_uthmani": "فَلَٓا اُقْسِمُ بِمَوَاقِعِ النُّجُومِۙ"}, {"verse_key": "56:76", "text_uthmani": "وَاِنَّهُ لَقَسَمٌ لَوْ تَعْلَمُونَ عَظ۪يمٌۙ"}, {"verse_key": "56:77", "text_uthmani": "اِنَّهُ لَقُرْاٰنٌ كَر۪يمٌۙ"}, {"verse_key": "56:78", "text_uthmani": "ف۪ي كِتَابٍ مَكْنُونٍۙ"}, {"verse_key": "56:79", "text_uthmani": "لَا يَمَسُّهُٓ اِلَّا الْمُطَهَّرُونَۜ"}, {"verse_key": "56:80", "text_uthmani": "تَنْز۪يلٌ مِنْ رَبِّ الْعَالَم۪ينَ"}, {"verse_key": "56:81", "text_uthmani": "اَفَبِهٰذَا الْحَد۪يثِ اَنْتُمْ مُدْهِنُونَۙ"}, {"verse_key": "56:82", "text_uthmani": "وَتَجْعَلُونَ رِزْقَكُمْ اَنَّكُمْ تُكَذِّبُونَ"}, {"verse_key": "56:83", "text_uthmani": "فَلَوْلَٓا اِذَا بَلَغَتِ الْحُلْقُومَۙ"}, {"verse_key": "56:84", "text_uthmani": "وَاَنْتُمْ ح۪ينَئِذٍ تَنْظُرُونَۙ"}, {"verse_key": "56:85", "text_uthmani": "وَنَحْنُ اَقْرَبُ اِلَيْهِ مِنْكُمْ وَلٰكِنْ لَا تُبْصِرُونَ"}, {"verse_key": "56:86", "text_uthmani": "فَلَوْلَٓا اِنْ كُنْتُمْ غَيْرَ مَد۪ين۪ينَۙ"}, {"verse_key": "56:87", "text_uthmani": "تَرْجِعُونَهَٓا اِنْ كُنْتُمْ صَادِق۪ينَ"}, {"verse_key": "56:88", "text_uthmani": "فَاَمَّٓا اِنْ كَانَ مِنَ الْمُقَرَّب۪ينَۙ"}, {"verse_key": "56:89", "text_uthmani": "فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَع۪يمٍ"}, {"verse_key": "56:90", "text_uthmani": "وَاَمَّٓا اِنْ كَانَ مِنْ اَصْحَابِ الْيَم۪ينِۙ"}, {"verse_key": "56:91", "text_uthmani": "فَسَلَامٌ لَكَ مِنْ اَصْحَابِ الْيَم۪ينِ"}, {"verse_key": "56:92", "text_uthmani": "وَاَمَّٓا اِنْ كَانَ مِنَ الْمُكَذِّب۪ينَ الضَّٓالّ۪ينَۙ"}, {"verse_key": "56:93", "text_uthmani": "فَنُزُلٌ مِنْ حَم۪يمٍۙ"}, {"verse_key": "56:94", "text_uthmani": "وَتَصْلِيَةُ جَح۪يمٍۙ"}, {"verse_key": "56:95", "text_uthmani": "اِنَّ هٰذَا لَهُوَ حَقُّ الْيَق۪ينِۚ"}, {"verse_key": "56:96", "text_uthmani": "فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظ۪يمِ"}]}