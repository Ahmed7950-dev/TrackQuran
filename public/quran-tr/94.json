{"verses": [{"verse_key": "94:1", "text_uthmani": "اَلَمْ نَشْرَحْ لَكَ صَدْرَكَۙ"}, {"verse_key": "94:2", "text_uthmani": "وَوَضَعْنَا عَنْكَ وِزْرَكَۙ"}, {"verse_key": "94:3", "text_uthmani": "اَلَّذ۪ٓي اَنْقَضَ ظَهْرَكَۙ"}, {"verse_key": "94:4", "text_uthmani": "وَرَفَعْنَا لَكَ ذِكْرَكَۜ"}, {"verse_key": "94:5", "text_uthmani": "فَاِنَّ مَعَ الْعُسْرِ يُسْرًاۙ"}, {"verse_key": "94:6", "text_uthmani": "اِنَّ مَعَ الْعُسْرِ يُسْرًاۜ"}, {"verse_key": "94:7", "text_uthmani": "فَاِذَا فَرَغْتَ فَانْصَبْۙ"}, {"verse_key": "94:8", "text_uthmani": "وَاِلٰى رَبِّكَ فَارْغَبْ"}]}