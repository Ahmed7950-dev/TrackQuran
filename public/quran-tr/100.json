{"verses": [{"verse_key": "100:1", "text_uthmani": "وَالْعَادِيَاتِ ضَبْحًاۙ"}, {"verse_key": "100:2", "text_uthmani": "فَالْمُورِيَاتِ قَدْحًاۙ"}, {"verse_key": "100:3", "text_uthmani": "فَالْمُغ۪يرَاتِ صُبْحًاۙ"}, {"verse_key": "100:4", "text_uthmani": "فَاَثَرْنَ بِه۪ نَقْعًاۙ"}, {"verse_key": "100:5", "text_uthmani": "فَوَسَطْنَ بِه۪ جَمْعًاۙ"}, {"verse_key": "100:6", "text_uthmani": "اِنَّ الْاِنْسَانَ لِرَبِّه۪ لَكَنُودٌۚ"}, {"verse_key": "100:7", "text_uthmani": "وَاِنَّهُ عَلٰى ذٰلِكَ لَشَه۪يدٌۚ"}, {"verse_key": "100:8", "text_uthmani": "وَاِنَّهُ لِحُبِّ الْخَيْرِ لَشَد۪يدٌۜ"}, {"verse_key": "100:9", "text_uthmani": "اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُورِۙ"}, {"verse_key": "100:10", "text_uthmani": "وَحُصِّلَ مَا فِي الصُّدُورِۙ"}, {"verse_key": "100:11", "text_uthmani": "اِنَّ رَبَّهُمْ بِهِمْ يَوْمَئِذٍ لَخَب۪يرٌ"}]}