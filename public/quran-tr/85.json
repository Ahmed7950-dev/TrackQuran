{"verses": [{"verse_key": "85:1", "text_uthmani": "وَالسَّمَٓاءِ ذَاتِ الْبُرُوجِۙ"}, {"verse_key": "85:2", "text_uthmani": "وَالْيَوْمِ الْمَوْعُودِۙ"}, {"verse_key": "85:3", "text_uthmani": "وَشَاهِدٍ وَمَشْهُودٍۜ"}, {"verse_key": "85:4", "text_uthmani": "قُتِلَ اَصْحَابُ الْاُخْدُودِۙ"}, {"verse_key": "85:5", "text_uthmani": "اَلنَّارِ ذَاتِ الْوَقُودِۙ"}, {"verse_key": "85:6", "text_uthmani": "اِذْ هُمْ عَلَيْهَا قُعُودٌۙ"}, {"verse_key": "85:7", "text_uthmani": "وَهُمْ عَلٰى مَا يَفْعَلُونَ بِالْمُؤْمِن۪ينَ شُهُودٌۜ"}, {"verse_key": "85:8", "text_uthmani": "وَمَا نَقَمُوا مِنْهُمْ اِلَّٓا اَنْ يُؤْمِنُوا بِاللّٰهِ الْعَز۪يزِ الْحَم۪يدِۙ"}, {"verse_key": "85:9", "text_uthmani": "اَلَّذ۪ي لَهُ مُلْكُ السَّمٰوَاتِ وَالْاَرْضِۜ وَاللّٰهُ عَلٰى كُلِّ شَيْءٍ شَه۪يدٌۜ"}, {"verse_key": "85:10", "text_uthmani": "اِنَّ الَّذ۪ينَ فَتَنُوا الْمُؤْمِن۪ينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَر۪يقِۜ"}, {"verse_key": "85:11", "text_uthmani": "اِنَّ الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْر۪ي مِنْ تَحْتِهَا الْاَنْهَارُۜ ذٰلِكَ الْفَوْزُ الْكَب۪يرُۜ"}, {"verse_key": "85:12", "text_uthmani": "اِنَّ بَطْشَ رَبِّكَ لَشَد۪يدٌۜ"}, {"verse_key": "85:13", "text_uthmani": "اِنَّهُ هُوَ يُبْدِئُ وَيُع۪يدُۚ"}, {"verse_key": "85:14", "text_uthmani": "وَهُوَ الْغَفُورُ الْوَدُودُۙ"}, {"verse_key": "85:15", "text_uthmani": "ذُو الْعَرْشِ الْمَج۪يدُۙ"}, {"verse_key": "85:16", "text_uthmani": "فَعَّالٌ لِمَا يُر۪يدُۜ"}, {"verse_key": "85:17", "text_uthmani": "هَلْ اَتٰيكَ حَد۪يثُ الْجُنُودِۙ"}, {"verse_key": "85:18", "text_uthmani": "فِرْعَوْنَ وَثَمُودَۜ"}, {"verse_key": "85:19", "text_uthmani": "بَلِ الَّذ۪ينَ كَفَرُوا ف۪ي تَكْذ۪يبٍۙ"}, {"verse_key": "85:20", "text_uthmani": "وَاللّٰهُ مِنْ وَرَٓائِهِمْ مُح۪يطٌۚ"}, {"verse_key": "85:21", "text_uthmani": "بَلْ هُوَ قُرْاٰنٌ مَج۪يدٌۙ"}, {"verse_key": "85:22", "text_uthmani": "ف۪ي لَوْحٍ مَحْفُوظٍ"}]}