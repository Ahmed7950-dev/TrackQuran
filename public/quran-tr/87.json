{"verses": [{"verse_key": "87:1", "text_uthmani": "سَبِّحِ اسْمَ رَبِّكَ الْاَعْلٰىۙ"}, {"verse_key": "87:2", "text_uthmani": "اَلَّذ۪ي خَلَقَ فَسَوّٰىۙۖ"}, {"verse_key": "87:3", "text_uthmani": "وَالَّذ۪ي قَدَّرَ فَهَدٰىۙۖ"}, {"verse_key": "87:4", "text_uthmani": "وَالَّذ۪ٓي اَخْرَجَ الْمَرْعٰىۙۖ"}, {"verse_key": "87:5", "text_uthmani": "فَجَعَلَهُ غُثَٓاءً اَحْوٰىۜ"}, {"verse_key": "87:6", "text_uthmani": "سَنُقْرِئُكَ فَلَا تَنْسٰىۙ"}, {"verse_key": "87:7", "text_uthmani": "اِلَّا مَا شَٓاءَ اللّٰهُۜ اِنَّهُ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰىۜ"}, {"verse_key": "87:8", "text_uthmani": "وَنُيَسِّرُكَ لِلْيُسْرٰىۚ"}, {"verse_key": "87:9", "text_uthmani": "فَذَكِّرْ اِنْ نَفَعَتِ الذِّكْرٰىۜ"}, {"verse_key": "87:10", "text_uthmani": "سَيَذَّكَّرُ مَنْ يَخْشٰىۙ"}, {"verse_key": "87:11", "text_uthmani": "وَيَتَجَنَّبُهَا الْاَشْقٰىۙ"}, {"verse_key": "87:12", "text_uthmani": "اَلَّذ۪ي يَصْلَى النَّارَ الْكُبْرٰىۚ"}, {"verse_key": "87:13", "text_uthmani": "ثُمَّ لَا يَمُوتُ ف۪يهَا وَلَا يَحْيٰىۜ"}, {"verse_key": "87:14", "text_uthmani": "قَدْ اَفْلَحَ مَنْ تَزَكّٰىۙ"}, {"verse_key": "87:15", "text_uthmani": "وَذَكَرَ اسْمَ رَبِّه۪ فَصَلّٰىۜ"}, {"verse_key": "87:16", "text_uthmani": "بَلْ تُؤْثِرُونَ الْحَيٰوةَ الدُّنْيَاۘ"}, {"verse_key": "87:17", "text_uthmani": "وَالْاٰخِرَةُ خَيْرٌ وَاَبْقٰىۜ"}, {"verse_key": "87:18", "text_uthmani": "اِنَّ هٰذَا لَفِي الصُّحُفِ الْاُو۫لٰىۙ"}, {"verse_key": "87:19", "text_uthmani": "صُحُفِ اِبْرٰه۪يمَ وَمُوسٰى"}]}