{"verses": [{"verse_key": "99:1", "text_uthmani": "اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَاۙ"}, {"verse_key": "99:2", "text_uthmani": "وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَاۙ"}, {"verse_key": "99:3", "text_uthmani": "وَقَالَ الْاِنْسَانُ مَا لَهَاۚ"}, {"verse_key": "99:4", "text_uthmani": "يَوْمَئِذٍ تُحَدِّثُ اَخْبَارَهَاۙ"}, {"verse_key": "99:5", "text_uthmani": "بِاَنَّ رَبَّكَ اَوْحٰى لَهَاۜ"}, {"verse_key": "99:6", "text_uthmani": "يَوْمَئِذٍ يَصْدُرُ النَّاسُ اَشْتَاتًاۙ لِيُرَوْا اَعْمَالَهُمْۜ"}, {"verse_key": "99:7", "text_uthmani": "فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۜ"}, {"verse_key": "99:8", "text_uthmani": "وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ"}]}