{"verses": [{"verse_key": "53:1", "text_uthmani": "وَالنَّجْمِ اِذَا هَوٰىۙ"}, {"verse_key": "53:2", "text_uthmani": "مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوٰىۚ"}, {"verse_key": "53:3", "text_uthmani": "وَمَا يَنْطِقُ عَنِ الْهَوٰىۜ"}, {"verse_key": "53:4", "text_uthmani": "اِنْ هُوَ اِلَّا وَحْيٌ يُوحٰىۙ"}, {"verse_key": "53:5", "text_uthmani": "عَلَّمَهُ شَد۪يدُ الْقُوٰىۙ"}, {"verse_key": "53:6", "text_uthmani": "ذُو مِرَّةٍۜ فَاسْتَوٰىۙ"}, {"verse_key": "53:7", "text_uthmani": "وَهُوَ بِالْاُفُقِ الْاَعْلٰىۜ"}, {"verse_key": "53:8", "text_uthmani": "ثُمَّ دَنَا فَتَدَلّٰىۙ"}, {"verse_key": "53:9", "text_uthmani": "فَكَانَ قَابَ قَوْسَيْنِ اَوْ اَدْنٰىۚ"}, {"verse_key": "53:10", "text_uthmani": "فَاَوْحٰٓى اِلٰى عَبْدِه۪ مَٓا اَوْحٰىۜ"}, {"verse_key": "53:11", "text_uthmani": "مَا كَذَبَ الْفُؤٰادُ مَا رَاٰى"}, {"verse_key": "53:12", "text_uthmani": "اَفَتُمَارُونَهُ عَلٰى مَا يَرٰى"}, {"verse_key": "53:13", "text_uthmani": "وَلَقَدْ رَاٰهُ نَزْلَةً اُخْرٰىۙ"}, {"verse_key": "53:14", "text_uthmani": "عِنْدَ سِدْرَةِ الْمُنْتَهٰى"}, {"verse_key": "53:15", "text_uthmani": "عِنْدَهَا جَنَّةُ الْمَأْوٰىۜ"}, {"verse_key": "53:16", "text_uthmani": "اِذْ يَغْشَى السِّدْرَةَ مَا يَغْشٰىۙ"}, {"verse_key": "53:17", "text_uthmani": "مَا زَاغَ الْبَصَرُ وَمَا طَغٰى"}, {"verse_key": "53:18", "text_uthmani": "لَقَدْ رَاٰى مِنْ اٰيَاتِ رَبِّهِ الْكُبْرٰى"}, {"verse_key": "53:19", "text_uthmani": "اَفَرَاَيْتُمُ اللَّاتَ وَالْعُزّٰىۙ"}, {"verse_key": "53:20", "text_uthmani": "وَمَنٰوةَ الثَّالِثَةَ الْاُخْرٰى"}, {"verse_key": "53:21", "text_uthmani": "اَلَكُمُ الذَّكَرُ وَلَهُ الْاُنْثٰى"}, {"verse_key": "53:22", "text_uthmani": "تِلْكَ اِذًا قِسْمَةٌ ض۪يزٰى"}, {"verse_key": "53:23", "text_uthmani": "اِنْ هِيَ اِلَّٓا اَسْمَٓاءٌ سَمَّيْتُمُوهَٓا اَنْتُمْ وَاٰبَٓاؤُ۬كُمْ مَٓا اَنْزَلَ اللّٰهُ بِهَا مِنْ سُلْطَانٍۜ اِنْ يَتَّبِعُونَ اِلَّا الظَّنَّ وَمَا تَهْوَى الْاَنْفُسُۚ وَلَقَدْ جَٓاءَهُمْ مِنْ رَبِّهِمُ الْهُدٰىۜ"}, {"verse_key": "53:24", "text_uthmani": "اَمْ لِلْاِنْسَانِ مَا تَمَنّٰىۘ"}, {"verse_key": "53:25", "text_uthmani": "فَلِلّٰهِ الْاٰخِرَةُ وَالْاُو۫لٰى۟"}, {"verse_key": "53:26", "text_uthmani": "وَكَمْ مِنْ مَلَكٍ فِي السَّمٰوَاتِ لَا تُغْن۪ي شَفَاعَتُهُمْ شَيْـًٔا اِلَّا مِنْ بَعْدِ اَنْ يَأْذَنَ اللّٰهُ لِمَنْ يَشَٓاءُ وَيَرْضٰى"}, {"verse_key": "53:27", "text_uthmani": "اِنَّ الَّذ۪ينَ لَا يُؤْمِنُونَ بِالْاٰخِرَةِ لَيُسَمُّونَ الْمَلٰٓئِكَةَ تَسْمِيَةَ الْاُنْثٰى"}, {"verse_key": "53:28", "text_uthmani": "وَمَا لَهُمْ بِه۪ مِنْ عِلْمٍۜ اِنْ يَتَّبِعُونَ اِلَّا الظَّنَّۚ وَاِنَّ الظَّنَّ لَا يُغْن۪ي مِنَ الْحَقِّ شَيْـًٔاۚ"}, {"verse_key": "53:29", "text_uthmani": "فَاَعْرِضْ عَنْ مَنْ تَوَلّٰى عَنْ ذِكْرِنَا وَلَمْ يُرِدْ اِلَّا الْحَيٰوةَ الدُّنْيَاۜ"}, {"verse_key": "53:30", "text_uthmani": "ذٰلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِۜ اِنَّ رَبَّكَ هُوَ اَعْلَمُ بِمَنْ ضَلَّ عَنْ سَب۪يلِه۪ وَهُوَ اَعْلَمُ بِمَنِ اهْتَدٰى"}, {"verse_key": "53:31", "text_uthmani": "وَلِلّٰهِ مَا فِي السَّمٰوَاتِ وَمَا فِي الْاَرْضِۙ لِيَجْزِيَ الَّذ۪ينَ اَسَٓاؤُ۫ا بِمَا عَمِلُوا وَيَجْزِيَ الَّذ۪ينَ اَحْسَنُوا بِالْحُسْنٰىۚ"}, {"verse_key": "53:32", "text_uthmani": "اَلَّذ۪ينَ يَجْتَنِبُونَ كَبَٓائِرَ الْاِثْمِ وَالْفَوَاحِشَ اِلَّا اللَّمَمَۜ اِنَّ رَبَّكَ وَاسِعُ الْمَغْفِرَةِۜ هُوَ اَعْلَمُ بِكُمْ اِذْ اَنْشَاَكُمْ مِنَ الْاَرْضِ وَاِذْ اَنْتُمْ اَجِنَّةٌ ف۪ي بُطُونِ اُمَّهَاتِكُمْۚ فَلَا تُزَكُّٓوا اَنْفُسَكُمْۜ هُوَ اَعْلَمُ بِمَنِ اتَّقٰى۟"}, {"verse_key": "53:33", "text_uthmani": "اَفَرَاَيْتَ الَّذ۪ي تَوَلّٰىۙ"}, {"verse_key": "53:34", "text_uthmani": "وَاَعْطٰى قَل۪يلًا وَاَكْدٰى"}, {"verse_key": "53:35", "text_uthmani": "اَعِنْدَهُ عِلْمُ الْغَيْبِ فَهُوَ يَرٰى"}, {"verse_key": "53:36", "text_uthmani": "اَمْ لَمْ يُنَبَّأْ بِمَا ف۪ي صُحُفِ مُوسٰىۙ"}, {"verse_key": "53:37", "text_uthmani": "وَاِبْرٰه۪يمَ الَّذ۪ي وَفّٰىۙ"}, {"verse_key": "53:38", "text_uthmani": "اَلَّا تَزِرُ وَازِرَةٌ وِزْرَ اُخْرٰىۙ"}, {"verse_key": "53:39", "text_uthmani": "وَاَنْ لَيْسَ لِلْاِنْسَانِ اِلَّا مَا سَعٰىۙ"}, {"verse_key": "53:40", "text_uthmani": "وَاَنَّ سَعْيَهُ سَوْفَ يُرٰىۖ"}, {"verse_key": "53:41", "text_uthmani": "ثُمَّ يُجْزٰيهُ الْجَزَٓاءَ الْاَوْفٰىۙ"}, {"verse_key": "53:42", "text_uthmani": "وَاَنَّ اِلٰى رَبِّكَ الْمُنْتَهٰىۙ"}, {"verse_key": "53:43", "text_uthmani": "وَاَنَّهُ هُوَ اَضْحَكَ وَاَبْكٰىۙ"}, {"verse_key": "53:44", "text_uthmani": "وَاَنَّهُ هُوَ اَمَاتَ وَاَحْيَاۙ"}, {"verse_key": "53:45", "text_uthmani": "وَاَنَّهُ خَلَقَ الزَّوْجَيْنِ الذَّكَرَ وَالْاُنْثٰىۙ"}, {"verse_key": "53:46", "text_uthmani": "مِنْ نُطْفَةٍ اِذَا تُمْنٰىۖ"}, {"verse_key": "53:47", "text_uthmani": "وَاَنَّ عَلَيْهِ النَّشْاَةَ الْاُخْرٰىۙ"}, {"verse_key": "53:48", "text_uthmani": "وَاَنَّهُ هُوَ اَغْنٰى وَاَقْنٰىۙ"}, {"verse_key": "53:49", "text_uthmani": "وَاَنَّهُ هُوَ رَبُّ الشِّعْرٰىۙ"}, {"verse_key": "53:50", "text_uthmani": "وَاَنَّهُٓ اَهْلَكَ عَادًاۨ الْاُو۫لٰىۙ"}, {"verse_key": "53:51", "text_uthmani": "وَثَمُودَا۬ فَمَٓا اَبْقٰىۙ"}, {"verse_key": "53:52", "text_uthmani": "وَقَوْمَ نُوحٍ مِنْ قَبْلُۜ اِنَّهُمْ كَانُوا هُمْ اَظْلَمَ وَاَطْغٰىۜ"}, {"verse_key": "53:53", "text_uthmani": "وَالْمُؤْتَفِكَةَ اَهْوٰىۙ"}, {"verse_key": "53:54", "text_uthmani": "فَغَشّٰيهَا مَا غَشّٰىۚ"}, {"verse_key": "53:55", "text_uthmani": "فَبِاَيِّ اٰلَٓاءِ رَبِّكَ تَتَمَارٰى"}, {"verse_key": "53:56", "text_uthmani": "هٰذَا نَذ۪يرٌ مِنَ النُّذُرِ الْاُو۫لٰى"}, {"verse_key": "53:57", "text_uthmani": "اَزِفَتِ الْاٰزِفَةُۚ"}, {"verse_key": "53:58", "text_uthmani": "لَيْسَ لَهَا مِنْ دُونِ اللّٰهِ كَاشِفَةٌ"}, {"verse_key": "53:59", "text_uthmani": "اَفَمِنْ هٰذَا الْحَد۪يثِ تَعْجَبُونَۙ"}, {"verse_key": "53:60", "text_uthmani": "وَتَضْحَكُونَ وَلَا تَبْكُونَۙ"}, {"verse_key": "53:61", "text_uthmani": "وَاَنْتُمْ سَامِدُونَ"}, {"verse_key": "53:62", "text_uthmani": "فَاسْجُدُوا لِلّٰهِ وَاعْبُدُوا"}]}