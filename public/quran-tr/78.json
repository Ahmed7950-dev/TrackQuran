{"verses": [{"verse_key": "78:1", "text_uthmani": "عَمَّ يَتَسَٓاءَلُونَۚ"}, {"verse_key": "78:2", "text_uthmani": "عَنِ النَّبَاِ الْعَظ۪يمِۙ"}, {"verse_key": "78:3", "text_uthmani": "اَلَّذ۪ي هُمْ ف۪يهِ مُخْتَلِفُونَۜ"}, {"verse_key": "78:4", "text_uthmani": "كَلَّا سَيَعْلَمُونَۙ"}, {"verse_key": "78:5", "text_uthmani": "ثُمَّ كَلَّا سَيَعْلَمُونَ"}, {"verse_key": "78:6", "text_uthmani": "اَلَمْ نَجْعَلِ الْاَرْضَ مِهَادًاۙ"}, {"verse_key": "78:7", "text_uthmani": "وَالْجِبَالَ اَوْتَادًاۖ"}, {"verse_key": "78:8", "text_uthmani": "وَخَلَقْنَاكُمْ اَزْوَاجًاۙ"}, {"verse_key": "78:9", "text_uthmani": "وَجَعَلْنَا نَوْمَكُمْ سُبَاتًاۙ"}, {"verse_key": "78:10", "text_uthmani": "وَجَعَلْنَا الَّيْلَ لِبَاسًاۙ"}, {"verse_key": "78:11", "text_uthmani": "وَجَعَلْنَا النَّهَارَ مَعَاشًاۖ"}, {"verse_key": "78:12", "text_uthmani": "وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًاۙ"}, {"verse_key": "78:13", "text_uthmani": "وَجَعَلْنَا سِرَاجًا وَهَّاجًاۖ"}, {"verse_key": "78:14", "text_uthmani": "وَاَنْزَلْنَا مِنَ الْمُعْصِرَاتِ مَٓاءً ثَجَّاجًاۙ"}, {"verse_key": "78:15", "text_uthmani": "لِنُخْرِجَ بِه۪ حَبًّا وَنَبَاتًاۙ"}, {"verse_key": "78:16", "text_uthmani": "وَجَنَّاتٍ اَلْفَافًاۜ"}, {"verse_key": "78:17", "text_uthmani": "اِنَّ يَوْمَ الْفَصْلِ كَانَ م۪يقَاتًاۙ"}, {"verse_key": "78:18", "text_uthmani": "يَوْمَ يُنْفَخُ فِي الصُّورِ فَتَأْتُونَ اَفْوَاجًاۙ"}, {"verse_key": "78:19", "text_uthmani": "وَفُتِحَتِ السَّمَٓاءُ فَكَانَتْ اَبْوَابًاۙ"}, {"verse_key": "78:20", "text_uthmani": "وَسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًاۜ"}, {"verse_key": "78:21", "text_uthmani": "اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًاۙ"}, {"verse_key": "78:22", "text_uthmani": "لِلطَّاغ۪ينَ مَاٰبًاۙ"}, {"verse_key": "78:23", "text_uthmani": "لَابِث۪ينَ ف۪يهَٓا اَحْقَابًاۚ"}, {"verse_key": "78:24", "text_uthmani": "لَا يَذُوقُونَ ف۪يهَا بَرْدًا وَلَا شَرَابًاۙ"}, {"verse_key": "78:25", "text_uthmani": "اِلَّا حَم۪يمًا وَغَسَّاقًاۙ"}, {"verse_key": "78:26", "text_uthmani": "جَزَٓاءً وِفَاقًا"}, {"verse_key": "78:27", "text_uthmani": "اِنَّهُمْ كَانُوا لَا يَرْجُونَ حِسَابًاۙ"}, {"verse_key": "78:28", "text_uthmani": "وَكَذَّبُوا بِاٰيَاتِنَا كِذَّابًاۜ"}, {"verse_key": "78:29", "text_uthmani": "وَكُلَّ شَيْءٍ اَحْصَيْنَاهُ كِتَابًا"}, {"verse_key": "78:30", "text_uthmani": "فَذُوقُوا فَلَنْ نَز۪يدَكُمْ اِلَّا عَذَابًا۟"}, {"verse_key": "78:31", "text_uthmani": "اِنَّ لِلْمُتَّق۪ينَ مَفَازًاۙ"}, {"verse_key": "78:32", "text_uthmani": "حَدَٓائِقَ وَاَعْنَابًاۙ"}, {"verse_key": "78:33", "text_uthmani": "وَكَوَاعِبَ اَتْرَابًاۙ"}, {"verse_key": "78:34", "text_uthmani": "وَكَأْسًا دِهَاقًاۜ"}, {"verse_key": "78:35", "text_uthmani": "لَا يَسْمَعُونَ ف۪يهَا لَغْوًا وَلَا كِذَّابًاۚ"}, {"verse_key": "78:36", "text_uthmani": "جَزَٓاءً مِنْ رَبِّكَ عَطَٓاءً حِسَابًاۙ"}, {"verse_key": "78:37", "text_uthmani": "رَبِّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَيْنَهُمَاۙ الرَّحْمٰنِ لَا يَمْلِكُونَ مِنْهُ خِطَابًاۙ"}, {"verse_key": "78:38", "text_uthmani": "يَوْمَ يَقُومُ الرُّوحُ وَالْمَلٰٓئِكَةُ صَفًّاۜ لَا يَتَكَلَّمُونَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا"}, {"verse_key": "78:39", "text_uthmani": "ذٰلِكَ الْيَوْمُ الْحَقُّۚ فَمَنْ شَٓاءَ اتَّخَذَ اِلٰى رَبِّه۪ مَاٰبًا"}, {"verse_key": "78:40", "text_uthmani": "اِنَّٓا اَنْذَرْنَاكُمْ عَذَابًا قَر۪يبًاۚ يَوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدَاهُ وَيَقُولُ الْكَافِرُ يَا لَيْتَن۪ي كُنْتُ تُرَابًا"}]}