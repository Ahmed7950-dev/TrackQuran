{"verses": [{"verse_key": "79:1", "text_uthmani": "وَالنَّازِعَاتِ غَرْقًاۙ"}, {"verse_key": "79:2", "text_uthmani": "وَالنَّاشِطَاتِ نَشْطًاۙ"}, {"verse_key": "79:3", "text_uthmani": "وَالسَّابِحَاتِ سَبْحًاۙ"}, {"verse_key": "79:4", "text_uthmani": "فَالسَّابِقَاتِ سَبْقًاۙ"}, {"verse_key": "79:5", "text_uthmani": "فَالْمُدَبِّرَاتِ اَمْرًاۢ"}, {"verse_key": "79:6", "text_uthmani": "يَوْمَ تَرْجُفُ الرَّاجِفَةُۙ"}, {"verse_key": "79:7", "text_uthmani": "تَتْبَعُهَا الرَّادِفَةُۜ"}, {"verse_key": "79:8", "text_uthmani": "قُلُوبٌ يَوْمَئِذٍ وَاجِفَةٌۙ"}, {"verse_key": "79:9", "text_uthmani": "اَبْصَارُهَا خَاشِعَةٌۢ"}, {"verse_key": "79:10", "text_uthmani": "يَقُولُونَ ءَاِنَّا لَمَرْدُودُونَ فِي الْحَافِرَةِۜ"}, {"verse_key": "79:11", "text_uthmani": "ءَاِذَا كُنَّا عِظَامًا نَخِرَةًۜ"}, {"verse_key": "79:12", "text_uthmani": "قَالُوا تِلْكَ اِذًا كَرَّةٌ خَاسِرَةٌۢ"}, {"verse_key": "79:13", "text_uthmani": "فَاِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌۙ"}, {"verse_key": "79:14", "text_uthmani": "فَاِذَا هُمْ بِالسَّاهِرَةِۜ"}, {"verse_key": "79:15", "text_uthmani": "هَلْ اَتٰيكَ حَد۪يثُ مُوسٰىۢ"}, {"verse_key": "79:16", "text_uthmani": "اِذْ نَادٰيهُ رَبُّهُ بِالْوَادِ الْمُقَدَّسِ طُوًىۚ"}, {"verse_key": "79:17", "text_uthmani": "اِذْهَبْ اِلٰى فِرْعَوْنَ اِنَّهُ طَغٰىۘ"}, {"verse_key": "79:18", "text_uthmani": "فَقُلْ هَلْ لَكَ اِلٰٓى اَنْ تَزَكّٰىۙ"}, {"verse_key": "79:19", "text_uthmani": "وَاَهْدِيَكَ اِلٰى رَبِّكَ فَتَخْشٰىۚ"}, {"verse_key": "79:20", "text_uthmani": "فَاَرٰيهُ الْاٰيَةَ الْكُبْرٰىۘ"}, {"verse_key": "79:21", "text_uthmani": "فَكَذَّبَ وَعَصٰىۘ"}, {"verse_key": "79:22", "text_uthmani": "ثُمَّ اَدْبَرَ يَسْعٰىۘ"}, {"verse_key": "79:23", "text_uthmani": "فَحَشَرَ فَنَادٰىۘ"}, {"verse_key": "79:24", "text_uthmani": "فَقَالَ اَنَا۬ رَبُّكُمُ الْاَعْلٰىۘ"}, {"verse_key": "79:25", "text_uthmani": "فَاَخَذَهُ اللّٰهُ نَكَالَ الْاٰخِرَةِ وَالْاُو۫لٰىۜ"}, {"verse_key": "79:26", "text_uthmani": "اِنَّ ف۪ي ذٰلِكَ لَعِبْرَةً لِمَنْ يَخْشٰىۜ۟"}, {"verse_key": "79:27", "text_uthmani": "ءَاَنْتُمْ اَشَدُّ خَلْقًا اَمِ السَّمَٓاءُۜ بَنٰيهَا۠"}, {"verse_key": "79:28", "text_uthmani": "رَفَعَ سَمْكَهَا فَسَوّٰيهَاۙ"}, {"verse_key": "79:29", "text_uthmani": "وَاَغْطَشَ لَيْلَهَا وَاَخْرَجَ ضُحٰيهَاۖ"}, {"verse_key": "79:30", "text_uthmani": "وَالْاَرْضَ بَعْدَ ذٰلِكَ دَحٰيهَاۜ"}, {"verse_key": "79:31", "text_uthmani": "اَخْرَجَ مِنْهَا مَٓاءَهَا وَمَرْعٰيهَاۖ"}, {"verse_key": "79:32", "text_uthmani": "وَالْجِبَالَ اَرْسٰيهَاۙ"}, {"verse_key": "79:33", "text_uthmani": "مَتَاعًا لَكُمْ وَلِاَنْعَامِكُمْۜ"}, {"verse_key": "79:34", "text_uthmani": "فَاِذَا جَٓاءَتِ الطَّٓامَّةُ الْكُبْرٰىۘ"}, {"verse_key": "79:35", "text_uthmani": "يَوْمَ يَتَذَكَّرُ الْاِنْسَانُ مَا سَعٰىۙ"}, {"verse_key": "79:36", "text_uthmani": "وَبُرِّزَتِ الْجَح۪يمُ لِمَنْ يَرٰى"}, {"verse_key": "79:37", "text_uthmani": "فَاَمَّا مَنْ طَغٰىۙ"}, {"verse_key": "79:38", "text_uthmani": "وَاٰثَرَ الْحَيٰوةَ الدُّنْيَاۙ"}, {"verse_key": "79:39", "text_uthmani": "فَاِنَّ الْجَح۪يمَ هِيَ الْمَأْوٰىۜ"}, {"verse_key": "79:40", "text_uthmani": "وَاَمَّا مَنْ خَافَ مَقَامَ رَبِّه۪ وَنَهَى النَّفْسَ عَنِ الْهَوٰىۙ"}, {"verse_key": "79:41", "text_uthmani": "فَاِنَّ الْجَنَّةَ هِيَ الْمَأْوٰىۜ"}, {"verse_key": "79:42", "text_uthmani": "يَسْـَٔلُونَكَ عَنِ السَّاعَةِ اَيَّانَ مُرْسٰيهَاۜ"}, {"verse_key": "79:43", "text_uthmani": "ف۪يمَ اَنْتَ مِنْ ذِكْرٰيهَاۜ"}, {"verse_key": "79:44", "text_uthmani": "اِلٰى رَبِّكَ مُنْتَهٰيهَاۜ"}, {"verse_key": "79:45", "text_uthmani": "اِنَّمَٓا اَنْتَ مُنْذِرُ مَنْ يَخْشٰيهَاۜ"}, {"verse_key": "79:46", "text_uthmani": "كَاَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُٓوا اِلَّا عَشِيَّةً اَوْ ضُحٰيهَا"}]}