{"verses": [{"verse_key": "95:1", "text_uthmani": "وَالتّ۪ينِ وَالزَّيْتُونِۙ"}, {"verse_key": "95:2", "text_uthmani": "وَطُورِ س۪ين۪ينَۙ"}, {"verse_key": "95:3", "text_uthmani": "وَهٰذَا الْبَلَدِ الْاَم۪ينِۙ"}, {"verse_key": "95:4", "text_uthmani": "لَقَدْ خَلَقْنَا الْاِنْسَانَ ف۪ٓي اَحْسَنِ تَقْو۪يمٍۘ"}, {"verse_key": "95:5", "text_uthmani": "ثُمَّ رَدَدْنَاهُ اَسْفَلَ سَافِل۪ينَۙ"}, {"verse_key": "95:6", "text_uthmani": "اِلَّا الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ اَجْرٌ غَيْرُ مَمْنُونٍۜ"}, {"verse_key": "95:7", "text_uthmani": "فَمَا يُكَذِّبُكَ بَعْدُ بِالدّ۪ينِۜ"}, {"verse_key": "95:8", "text_uthmani": "اَلَيْسَ اللّٰهُ بِاَحْكَمِ الْحَاكِم۪ينَ"}]}