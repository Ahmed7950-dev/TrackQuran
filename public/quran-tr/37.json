{"verses": [{"verse_key": "37:1", "text_uthmani": "وَالصَّٓافَّاتِ صَفًّاۙ"}, {"verse_key": "37:2", "text_uthmani": "فَالزَّاجِرَاتِ زَجْرًاۙ"}, {"verse_key": "37:3", "text_uthmani": "فَالتَّالِيَاتِ ذِكْرًاۙ"}, {"verse_key": "37:4", "text_uthmani": "اِنَّ اِلٰهَكُمْ لَوَاحِدٌۜ"}, {"verse_key": "37:5", "text_uthmani": "رَبُّ السَّمٰوَاتِ وَالْاَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِۜ"}, {"verse_key": "37:6", "text_uthmani": "اِنَّا زَيَّنَّا السَّمَٓاءَ الدُّنْيَا بِز۪ينَةٍۨ الْكَوَاكِبِۙ"}, {"verse_key": "37:7", "text_uthmani": "وَحِفْظًا مِنْ كُلِّ شَيْطَانٍ مَارِدٍۚ"}, {"verse_key": "37:8", "text_uthmani": "لَا يَسَّمَّعُونَ اِلَى الْمَلَاِ الْاَعْلٰى وَيُقْذَفُونَ مِنْ كُلِّ جَانِبٍۗ"}, {"verse_key": "37:9", "text_uthmani": "دُحُورًا وَلَهُمْ عَذَابٌ وَاصِبٌۙ"}, {"verse_key": "37:10", "text_uthmani": "اِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَاَتْبَعَهُ شِهَابٌ ثَاقِبٌ"}, {"verse_key": "37:11", "text_uthmani": "فَاسْتَفْتِهِمْ اَهُمْ اَشَدُّ خَلْقًا اَمْ مَنْ خَلَقْنَاۜ اِنَّا خَلَقْنَاهُمْ مِنْ ط۪ينٍ لَازِبٍ"}, {"verse_key": "37:12", "text_uthmani": "بَلْ عَجِبْتَ وَيَسْخَرُونَۖ"}, {"verse_key": "37:13", "text_uthmani": "وَاِذَا ذُكِّرُوا لَا يَذْكُرُونَۖ"}, {"verse_key": "37:14", "text_uthmani": "وَاِذَا رَاَوْا اٰيَةً يَسْتَسْخِرُونَۖ"}, {"verse_key": "37:15", "text_uthmani": "وَقَالُٓوا اِنْ هٰذَٓا اِلَّا سِحْرٌ مُب۪ينٌۚ"}, {"verse_key": "37:16", "text_uthmani": "ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا ءَاِنَّا لَمَبْعُوثُونَۙ"}, {"verse_key": "37:17", "text_uthmani": "اَوَاٰبَٓاؤُ۬نَا الْاَوَّلُونَۜ"}, {"verse_key": "37:18", "text_uthmani": "قُلْ نَعَمْ وَاَنْتُمْ دَاخِرُونَۚ"}, {"verse_key": "37:19", "text_uthmani": "فَاِنَّمَا هِيَ زَجْرَةٌ وَاحِدَةٌ فَاِذَا هُمْ يَنْظُرُونَ"}, {"verse_key": "37:20", "text_uthmani": "وَقَالُوا يَا وَيْلَنَا هٰذَا يَوْمُ الدّ۪ينِ"}, {"verse_key": "37:21", "text_uthmani": "هٰذَا يَوْمُ الْفَصْلِ الَّذ۪ي كُنْتُمْ بِه۪ تُكَذِّبُونَ۟"}, {"verse_key": "37:22", "text_uthmani": "اُحْشُرُوا الَّذ۪ينَ ظَلَمُوا وَاَزْوَاجَهُمْ وَمَا كَانُوا يَعْبُدُونَۙ"}, {"verse_key": "37:23", "text_uthmani": "مِنْ دُونِ اللّٰهِ فَاهْدُوهُمْ اِلٰى صِرَاطِ الْجَح۪يمِۙ"}, {"verse_key": "37:24", "text_uthmani": "وَقِفُوهُمْ اِنَّهُمْ مَسْؤُ۫لُونَۙ"}, {"verse_key": "37:25", "text_uthmani": "مَا لَكُمْ لَا تَنَاصَرُونَ"}, {"verse_key": "37:26", "text_uthmani": "بَلْ هُمُ الْيَوْمَ مُسْتَسْلِمُونَ"}, {"verse_key": "37:27", "text_uthmani": "وَاَقْبَلَ بَعْضُهُمْ عَلٰى بَعْضٍ يَتَسَٓاءَلُونَ"}, {"verse_key": "37:28", "text_uthmani": "قَالُٓوا اِنَّكُمْ كُنْتُمْ تَأْتُونَنَا عَنِ الْيَم۪ينِ"}, {"verse_key": "37:29", "text_uthmani": "قَالُوا بَلْ لَمْ تَكُونُوا مُؤْمِن۪ينَۚ"}, {"verse_key": "37:30", "text_uthmani": "وَمَا كَانَ لَنَا عَلَيْكُمْ مِنْ سُلْطَانٍۚ بَلْ كُنْتُمْ قَوْمًا طَاغ۪ينَ"}, {"verse_key": "37:31", "text_uthmani": "فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَاۗ اِنَّا لَذَٓائِقُونَ"}, {"verse_key": "37:32", "text_uthmani": "فَاَغْوَيْنَاكُمْ اِنَّا كُنَّا غَاو۪ينَ"}, {"verse_key": "37:33", "text_uthmani": "فَاِنَّهُمْ يَوْمَئِذٍ فِي الْعَذَابِ مُشْتَرِكُونَ"}, {"verse_key": "37:34", "text_uthmani": "اِنَّا كَذٰلِكَ نَفْعَلُ بِالْمُجْرِم۪ينَ"}, {"verse_key": "37:35", "text_uthmani": "اِنَّهُمْ كَانُٓوا اِذَا ق۪يلَ لَهُمْ لَٓا اِلٰهَ اِلَّا اللّٰهُ يَسْتَكْبِرُونَۙ"}, {"verse_key": "37:36", "text_uthmani": "وَيَقُولُونَ اَئِنَّا لَتَارِكُٓوا اٰلِهَتِنَا لِشَاعِرٍ مَجْنُونٍۜ"}, {"verse_key": "37:37", "text_uthmani": "بَلْ جَٓاءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَل۪ينَ"}, {"verse_key": "37:38", "text_uthmani": "اِنَّكُمْ لَذَٓائِقُوا الْعَذَابِ الْاَل۪يمِۚ"}, {"verse_key": "37:39", "text_uthmani": "وَمَا تُجْزَوْنَ اِلَّا مَا كُنْتُمْ تَعْمَلُونَۙ"}, {"verse_key": "37:40", "text_uthmani": "اِلَّا عِبَادَ اللّٰهِ الْمُخْلَص۪ينَ"}, {"verse_key": "37:41", "text_uthmani": "اُو۬لٰٓئِكَ لَهُمْ رِزْقٌ مَعْلُومٌۙ"}, {"verse_key": "37:42", "text_uthmani": "فَوَاكِهُۚ وَهُمْ مُكْرَمُونَۙ"}, {"verse_key": "37:43", "text_uthmani": "ف۪ي جَنَّاتِ النَّع۪يمِۙ"}, {"verse_key": "37:44", "text_uthmani": "عَلٰى سُرُرٍ مُتَقَابِل۪ينَ"}, {"verse_key": "37:45", "text_uthmani": "يُطَافُ عَلَيْهِمْ بِكَأْسٍ مِنْ مَع۪ينٍۙ"}, {"verse_key": "37:46", "text_uthmani": "بَيْضَٓاءَ لَذَّةٍ لِلشَّارِب۪ينَۚ"}, {"verse_key": "37:47", "text_uthmani": "لَا ف۪يهَا غَوْلٌ وَلَا هُمْ عَنْهَا يُنْزَفُونَ"}, {"verse_key": "37:48", "text_uthmani": "وَعِنْدَهُمْ قَاصِرَاتُ الطَّرْفِ ع۪ينٌۙ"}, {"verse_key": "37:49", "text_uthmani": "كَاَنَّهُنَّ بَيْضٌ مَكْنُونٌ"}, {"verse_key": "37:50", "text_uthmani": "فَاَقْبَلَ بَعْضُهُمْ عَلٰى بَعْضٍ يَتَسَٓاءَلُونَ"}, {"verse_key": "37:51", "text_uthmani": "قَالَ قَٓائِلٌ مِنْهُمْ اِنّ۪ي كَانَ ل۪ي قَر۪ينٌۙ"}, {"verse_key": "37:52", "text_uthmani": "يَقُولُ اَئِنَّكَ لَمِنَ الْمُصَدِّق۪ينَ"}, {"verse_key": "37:53", "text_uthmani": "ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَامًا ءَاِنَّا لَمَد۪ينُونَ"}, {"verse_key": "37:54", "text_uthmani": "قَالَ هَلْ اَنْتُمْ مُطَّلِعُونَ"}, {"verse_key": "37:55", "text_uthmani": "فَاطَّلَعَ فَرَاٰهُ ف۪ي سَوَٓاءِ الْجَح۪يمِ"}, {"verse_key": "37:56", "text_uthmani": "قَالَ تَاللّٰهِ اِنْ كِدْتَ لَتُرْد۪ينِۙ"}, {"verse_key": "37:57", "text_uthmani": "وَلَوْلَا نِعْمَةُ رَبّ۪ي لَكُنْتُ مِنَ الْمُحْضَر۪ينَ"}, {"verse_key": "37:58", "text_uthmani": "اَفَمَا نَحْنُ بِمَيِّت۪ينَۙ"}, {"verse_key": "37:59", "text_uthmani": "اِلَّا مَوْتَتَنَا الْاُو۫لٰى وَمَا نَحْنُ بِمُعَذَّب۪ينَ"}, {"verse_key": "37:60", "text_uthmani": "اِنَّ هٰذَا لَهُوَ الْفَوْزُ الْعَظ۪يمُ"}, {"verse_key": "37:61", "text_uthmani": "لِمِثْلِ هٰذَا فَلْيَعْمَلِ الْعَامِلُونَ"}, {"verse_key": "37:62", "text_uthmani": "اَذٰلِكَ خَيْرٌ نُزُلًا اَمْ شَجَرَةُ الزَّقُّومِ"}, {"verse_key": "37:63", "text_uthmani": "اِنَّا جَعَلْنَاهَا فِتْنَةً لِلظَّالِم۪ينَ"}, {"verse_key": "37:64", "text_uthmani": "اِنَّهَا شَجَرَةٌ تَخْرُجُ ف۪ٓي اَصْلِ الْجَح۪يمِۙ"}, {"verse_key": "37:65", "text_uthmani": "طَلْعُهَا كَاَنَّهُ رُؤُ۫سُ الشَّيَاط۪ينِ"}, {"verse_key": "37:66", "text_uthmani": "فَاِنَّهُمْ لَاٰكِلُونَ مِنْهَا فَمَالِؤُ۫نَ مِنْهَا الْبُطُونَۜ"}, {"verse_key": "37:67", "text_uthmani": "ثُمَّ اِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِنْ حَم۪يمٍۚ"}, {"verse_key": "37:68", "text_uthmani": "ثُمَّ اِنَّ مَرْجِعَهُمْ لَاِلَى الْجَح۪يمِ"}, {"verse_key": "37:69", "text_uthmani": "اِنَّهُمْ اَلْفَوْا اٰبَٓاءَهُمْ ضَٓالّ۪ينَۙ"}, {"verse_key": "37:70", "text_uthmani": "فَهُمْ عَلٰٓى اٰثَارِهِمْ يُهْرَعُونَ"}, {"verse_key": "37:71", "text_uthmani": "وَلَقَدْ ضَلَّ قَبْلَهُمْ اَكْثَرُ الْاَوَّل۪ينَۙ"}, {"verse_key": "37:72", "text_uthmani": "وَلَقَدْ اَرْسَلْنَا ف۪يهِمْ مُنْذِر۪ينَ"}, {"verse_key": "37:73", "text_uthmani": "فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَر۪ينَۙ"}, {"verse_key": "37:74", "text_uthmani": "اِلَّا عِبَادَ اللّٰهِ الْمُخْلَص۪ينَ۟"}, {"verse_key": "37:75", "text_uthmani": "وَلَقَدْ نَادٰينَا نُوحٌ فَلَنِعْمَ الْمُج۪يبُونَۚ"}, {"verse_key": "37:76", "text_uthmani": "وَنَجَّيْنَاهُ وَاَهْلَهُ مِنَ الْكَرْبِ الْعَظ۪يمِۘ"}, {"verse_key": "37:77", "text_uthmani": "وَجَعَلْنَا ذُرِّيَّتَهُ هُمُ الْبَاق۪ينَۘ"}, {"verse_key": "37:78", "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِي الْاٰخِر۪ينَۘ"}, {"verse_key": "37:79", "text_uthmani": "سَلَامٌ عَلٰى نُوحٍ فِي الْعَالَم۪ينَ"}, {"verse_key": "37:80", "text_uthmani": "اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِن۪ينَ"}, {"verse_key": "37:81", "text_uthmani": "اِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِن۪ينَ"}, {"verse_key": "37:82", "text_uthmani": "ثُمَّ اَغْرَقْنَا الْاٰخَر۪ينَ"}, {"verse_key": "37:83", "text_uthmani": "وَاِنَّ مِنْ ش۪يعَتِه۪ لَاِبْرٰه۪يمَۢ"}, {"verse_key": "37:84", "text_uthmani": "اِذْ جَٓاءَ رَبَّهُ بِقَلْبٍ سَل۪يمٍ"}, {"verse_key": "37:85", "text_uthmani": "اِذْ قَالَ لِاَب۪يهِ وَقَوْمِه۪ مَاذَا تَعْبُدُونَۚ"}, {"verse_key": "37:86", "text_uthmani": "اَئِفْكًا اٰلِهَةً دُونَ اللّٰهِ تُر۪يدُونَۜ"}, {"verse_key": "37:87", "text_uthmani": "فَمَا ظَنُّكُمْ بِرَبِّ الْعَالَم۪ينَ"}, {"verse_key": "37:88", "text_uthmani": "فَنَظَرَ نَظْرَةً فِي النُّجُومِۙ"}, {"verse_key": "37:89", "text_uthmani": "فَقَالَ اِنّ۪ي سَق۪يمٌ"}, {"verse_key": "37:90", "text_uthmani": "فَتَوَلَّوْا عَنْهُ مُدْبِر۪ينَ"}, {"verse_key": "37:91", "text_uthmani": "فَرَاغَ اِلٰٓى اٰلِهَتِهِمْ فَقَالَ اَلَا تَأْكُلُونَۚ"}, {"verse_key": "37:92", "text_uthmani": "مَا لَكُمْ لَا تَنْطِقُونَ"}, {"verse_key": "37:93", "text_uthmani": "فَرَاغَ عَلَيْهِمْ ضَرْبًا بِالْيَم۪ينِ"}, {"verse_key": "37:94", "text_uthmani": "فَاَقْبَلُٓوا اِلَيْهِ يَزِفُّونَ"}, {"verse_key": "37:95", "text_uthmani": "قَالَ اَتَعْبُدُونَ مَا تَنْحِتُونَۙ"}, {"verse_key": "37:96", "text_uthmani": "وَاللّٰهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ"}, {"verse_key": "37:97", "text_uthmani": "قَالُوا ابْنُوا لَهُ بُنْيَانًا فَاَلْقُوهُ فِي الْجَح۪يمِ"}, {"verse_key": "37:98", "text_uthmani": "فَاَرَادُوا بِه۪ كَيْدًا فَجَعَلْنَاهُمُ الْاَسْفَل۪ينَ"}, {"verse_key": "37:99", "text_uthmani": "وَقَالَ اِنّ۪ي ذَاهِبٌ اِلٰى رَبّ۪ي سَيَهْد۪ينِ"}, {"verse_key": "37:100", "text_uthmani": "رَبِّ هَبْ ل۪ي مِنَ الصَّالِح۪ينَ"}, {"verse_key": "37:101", "text_uthmani": "فَبَشَّرْنَاهُ بِغُلَامٍ حَل۪يمٍ"}, {"verse_key": "37:102", "text_uthmani": "فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ قَالَ يَا بُنَيَّ اِنّ۪ٓي اَرٰى فِي الْمَنَامِ اَنّ۪ٓي اَذْبَحُكَ فَانْظُرْ مَاذَا تَرٰىۜ قَالَ يَٓا اَبَتِ افْعَلْ مَا تُؤْمَرُۘ سَتَجِدُن۪ٓي اِنْ شَٓاءَ اللّٰهُ مِنَ الصَّابِر۪ينَ"}, {"verse_key": "37:103", "text_uthmani": "فَلَمَّٓا اَسْلَمَا وَتَلَّهُ لِلْجَب۪ينِۚ"}, {"verse_key": "37:104", "text_uthmani": "وَنَادَيْنَاهُ اَنْ يَٓا اِبْرٰه۪يمُۙ"}, {"verse_key": "37:105", "text_uthmani": "قَدْ صَدَّقْتَ الرُّءْيَاۚ اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِن۪ينَ"}, {"verse_key": "37:106", "text_uthmani": "اِنَّ هٰذَا لَهُوَ الْبَلٰٓؤُ۬ا الْمُب۪ينُ"}, {"verse_key": "37:107", "text_uthmani": "وَفَدَيْنَاهُ بِذِبْحٍ عَظ۪يمٍ"}, {"verse_key": "37:108", "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِي الْاٰخِر۪ينَ"}, {"verse_key": "37:109", "text_uthmani": "سَلَامٌ عَلٰٓى اِبْرٰه۪يمَ"}, {"verse_key": "37:110", "text_uthmani": "كَذٰلِكَ نَجْزِي الْمُحْسِن۪ينَ"}, {"verse_key": "37:111", "text_uthmani": "اِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِن۪ينَ"}, {"verse_key": "37:112", "text_uthmani": "وَبَشَّرْنَاهُ بِاِسْحٰقَ نَبِيًّا مِنَ الصَّالِح۪ينَ"}, {"verse_key": "37:113", "text_uthmani": "وَبَارَكْنَا عَلَيْهِ وَعَلٰٓى اِسْحٰقَۜ وَمِنْ ذُرِّيَّتِهِمَا مُحْسِنٌ وَظَالِمٌ لِنَفْسِه۪ مُب۪ينٌ۟"}, {"verse_key": "37:114", "text_uthmani": "وَلَقَدْ مَنَنَّا عَلٰى مُوسٰى وَهٰرُونَۚ"}, {"verse_key": "37:115", "text_uthmani": "وَنَجَّيْنَاهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظ۪يمِۚ"}, {"verse_key": "37:116", "text_uthmani": "وَنَصَرْنَاهُمْ فَكَانُوا هُمُ الْغَالِب۪ينَۚ"}, {"verse_key": "37:117", "text_uthmani": "وَاٰتَيْنَاهُمَا الْكِتَابَ الْمُسْتَب۪ينَۚ"}, {"verse_key": "37:118", "text_uthmani": "وَهَدَيْنَاهُمَا الصِّرَاطَ الْمُسْتَق۪يمَۚ"}, {"verse_key": "37:119", "text_uthmani": "وَتَرَكْنَا عَلَيْهِمَا فِي الْاٰخِر۪ينَ"}, {"verse_key": "37:120", "text_uthmani": "سَلَامٌ عَلٰى مُوسٰى وَهٰرُونَ"}, {"verse_key": "37:121", "text_uthmani": "اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِن۪ينَ"}, {"verse_key": "37:122", "text_uthmani": "اِنَّهُمَا مِنْ عِبَادِنَا الْمُؤْمِن۪ينَ"}, {"verse_key": "37:123", "text_uthmani": "وَاِنَّ اِلْيَاسَ لَمِنَ الْمُرْسَل۪ينَۜ"}, {"verse_key": "37:124", "text_uthmani": "اِذْ قَالَ لِقَوْمِه۪ٓ اَلَا تَتَّقُونَ"}, {"verse_key": "37:125", "text_uthmani": "اَتَدْعُونَ بَعْلًا وَتَذَرُونَ اَحْسَنَ الْخَالِق۪ينَۙ"}, {"verse_key": "37:126", "text_uthmani": "اَللّٰهَ رَبَّكُمْ وَرَبَّ اٰبَٓائِكُمُ الْاَوَّل۪ينَ"}, {"verse_key": "37:127", "text_uthmani": "فَكَذَّبُوهُ فَاِنَّهُمْ لَمُحْضَرُونَۙ"}, {"verse_key": "37:128", "text_uthmani": "اِلَّا عِبَادَ اللّٰهِ الْمُخْلَص۪ينَ"}, {"verse_key": "37:129", "text_uthmani": "وَتَرَكْنَا عَلَيْهِ فِي الْاٰخِر۪ينَ"}, {"verse_key": "37:130", "text_uthmani": "سَلَامٌ عَلٰٓى اِلْ‌يَاس۪ينَ"}, {"verse_key": "37:131", "text_uthmani": "اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِن۪ينَ"}, {"verse_key": "37:132", "text_uthmani": "اِنَّهُ مِنْ عِبَادِنَا الْمُؤْمِن۪ينَ"}, {"verse_key": "37:133", "text_uthmani": "وَاِنَّ لُوطًا لَمِنَ الْمُرْسَل۪ينَۜ"}, {"verse_key": "37:134", "text_uthmani": "اِذْ نَجَّيْنَاهُ وَاَهْلَهُٓ اَجْمَع۪ينَۙ"}, {"verse_key": "37:135", "text_uthmani": "اِلَّا عَجُوزًا فِي الْغَابِر۪ينَ"}, {"verse_key": "37:136", "text_uthmani": "ثُمَّ دَمَّرْنَا الْاٰخَر۪ينَ"}, {"verse_key": "37:137", "text_uthmani": "وَاِنَّكُمْ لَتَمُرُّونَ عَلَيْهِمْ مُصْبِح۪ينَۙ"}, {"verse_key": "37:138", "text_uthmani": "وَبِالَّيْلِۜ اَفَلَا تَعْقِلُونَ۟"}, {"verse_key": "37:139", "text_uthmani": "وَاِنَّ يُونُسَ لَمِنَ الْمُرْسَل۪ينَۜ"}, {"verse_key": "37:140", "text_uthmani": "اِذْ اَبَقَ اِلَى الْفُلْكِ الْمَشْحُونِۙ"}, {"verse_key": "37:141", "text_uthmani": "فَسَاهَمَ فَكَانَ مِنَ الْمُدْحَض۪ينَۚ"}, {"verse_key": "37:142", "text_uthmani": "فَالْتَقَمَهُ الْحُوتُ وَهُوَ مُل۪يمٌ"}, {"verse_key": "37:143", "text_uthmani": "فَلَوْلَٓا اَنَّهُ كَانَ مِنَ الْمُسَبِّح۪ينَۙ"}, {"verse_key": "37:144", "text_uthmani": "لَلَبِثَ ف۪ي بَطْنِه۪ٓ اِلٰى يَوْمِ يُبْعَثُونَ"}, {"verse_key": "37:145", "text_uthmani": "فَنَبَذْنَاهُ بِالْعَرَٓاءِ وَهُوَ سَق۪يمٌۚ"}, {"verse_key": "37:146", "text_uthmani": "وَاَنْبَتْنَا عَلَيْهِ شَجَرَةً مِنْ يَقْط۪ينٍۚ"}, {"verse_key": "37:147", "text_uthmani": "وَاَرْسَلْنَاهُ اِلٰى مِائَةِ اَلْفٍ اَوْ يَز۪يدُونَۚ"}, {"verse_key": "37:148", "text_uthmani": "فَاٰمَنُوا فَمَتَّعْنَاهُمْ اِلٰى ح۪ينٍۜ"}, {"verse_key": "37:149", "text_uthmani": "فَاسْتَفْتِهِمْ اَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُونَۙ"}, {"verse_key": "37:150", "text_uthmani": "اَمْ خَلَقْنَا الْمَلٰٓئِكَةَ اِنَاثًا وَهُمْ شَاهِدُونَ"}, {"verse_key": "37:151", "text_uthmani": "اَلَٓا اِنَّهُمْ مِنْ اِفْكِهِمْ لَيَقُولُونَۙ"}, {"verse_key": "37:152", "text_uthmani": "وَلَدَ اللّٰهُۙ وَاِنَّهُمْ لَكَاذِبُونَ"}, {"verse_key": "37:153", "text_uthmani": "اَصْطَفَى الْبَنَاتِ عَلَى الْبَن۪ينَۜ"}, {"verse_key": "37:154", "text_uthmani": "مَا لَكُمْ۠ كَيْفَ تَحْكُمُونَ"}, {"verse_key": "37:155", "text_uthmani": "اَفَلَا تَذَكَّرُونَۚ"}, {"verse_key": "37:156", "text_uthmani": "اَمْ لَكُمْ سُلْطَانٌ مُب۪ينٌۙ"}, {"verse_key": "37:157", "text_uthmani": "فَأْتُوا بِكِتَابِكُمْ اِنْ كُنْتُمْ صَادِق۪ينَ"}, {"verse_key": "37:158", "text_uthmani": "وَجَعَلُوا بَيْنَهُ وَبَيْنَ الْجِنَّةِ نَسَبًاۜ وَلَقَدْ عَلِمَتِ الْجِنَّةُ اِنَّهُمْ لَمُحْضَرُونَۙ"}, {"verse_key": "37:159", "text_uthmani": "سُبْحَانَ اللّٰهِ عَمَّا يَصِفُونَۙ"}, {"verse_key": "37:160", "text_uthmani": "اِلَّا عِبَادَ اللّٰهِ الْمُخْلَص۪ينَ"}, {"verse_key": "37:161", "text_uthmani": "فَاِنَّكُمْ وَمَا تَعْبُدُونَۙ"}, {"verse_key": "37:162", "text_uthmani": "مَٓا اَنْتُمْ عَلَيْهِ بِفَاتِن۪ينَۙ"}, {"verse_key": "37:163", "text_uthmani": "اِلَّا مَنْ هُوَ صَالِ الْجَح۪يمِ"}, {"verse_key": "37:164", "text_uthmani": "وَمَا مِنَّٓا اِلَّا لَهُ مَقَامٌ مَعْلُومٌ"}, {"verse_key": "37:165", "text_uthmani": "وَاِنَّا لَنَحْنُ الصَّٓافُّونَۚ"}, {"verse_key": "37:166", "text_uthmani": "وَاِنَّا لَنَحْنُ الْمُسَبِّحُونَ"}, {"verse_key": "37:167", "text_uthmani": "وَاِنْ كَانُوا لَيَقُولُونَۙ"}, {"verse_key": "37:168", "text_uthmani": "لَوْ اَنَّ عِنْدَنَا ذِكْرًا مِنَ الْاَوَّل۪ينَۙ"}, {"verse_key": "37:169", "text_uthmani": "لَكُنَّا عِبَادَ اللّٰهِ الْمُخْلَص۪ينَ"}, {"verse_key": "37:170", "text_uthmani": "فَكَفَرُوا بِه۪ۚ فَسَوْفَ يَعْلَمُونَ"}, {"verse_key": "37:171", "text_uthmani": "وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَل۪ينَۚ"}, {"verse_key": "37:172", "text_uthmani": "اِنَّهُمْ لَهُمُ الْمَنْصُورُونَۖ"}, {"verse_key": "37:173", "text_uthmani": "وَاِنَّ جُنْدَنَا لَهُمُ الْغَالِبُونَ"}, {"verse_key": "37:174", "text_uthmani": "فَتَوَلَّ عَنْهُمْ حَتّٰى ح۪ينٍۙ"}, {"verse_key": "37:175", "text_uthmani": "وَاَبْصِرْهُمْ فَسَوْفَ يُبْصِرُونَ"}, {"verse_key": "37:176", "text_uthmani": "اَفَبِعَذَابِنَا يَسْتَعْجِلُونَ"}, {"verse_key": "37:177", "text_uthmani": "فَاِذَا نَزَلَ بِسَاحَتِهِمْ فَسَٓاءَ صَبَاحُ الْمُنْذَر۪ينَ"}, {"verse_key": "37:178", "text_uthmani": "وَتَوَلَّ عَنْهُمْ حَتّٰى ح۪ينٍۙ"}, {"verse_key": "37:179", "text_uthmani": "وَاَبْصِرْ فَسَوْفَ يُبْصِرُونَ"}, {"verse_key": "37:180", "text_uthmani": "سُبْحَانَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُونَۚ"}, {"verse_key": "37:181", "text_uthmani": "وَسَلَامٌ عَلَى الْمُرْسَل۪ينَۚ"}, {"verse_key": "37:182", "text_uthmani": "وَالْحَمْدُ لِلّٰهِ رَبِّ الْعَالَم۪ينَ"}]}