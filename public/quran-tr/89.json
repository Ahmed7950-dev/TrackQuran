{"verses": [{"verse_key": "89:1", "text_uthmani": "وَالْفَجْرِۙ"}, {"verse_key": "89:2", "text_uthmani": "وَلَيَالٍ عَشْرٍۙ"}, {"verse_key": "89:3", "text_uthmani": "وَالشَّفْعِ وَالْوَتْرِۙ"}, {"verse_key": "89:4", "text_uthmani": "وَالَّيْلِ اِذَا يَسْرِۚ"}, {"verse_key": "89:5", "text_uthmani": "هَلْ ف۪ي ذٰلِكَ قَسَمٌ لِذ۪ي حِجْرٍۜ"}, {"verse_key": "89:6", "text_uthmani": "اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍۙۖ"}, {"verse_key": "89:7", "text_uthmani": "اِرَمَ ذَاتِ الْعِمَادِۙۖ"}, {"verse_key": "89:8", "text_uthmani": "اَلَّت۪ي لَمْ يُخْلَقْ مِثْلُهَا فِي الْبِلَادِۙۖ"}, {"verse_key": "89:9", "text_uthmani": "وَثَمُودَ الَّذ۪ينَ جَابُوا الصَّخْرَ بِالْوَادِۙۖ"}, {"verse_key": "89:10", "text_uthmani": "وَفِرْعَوْنَ ذِي الْاَوْتَادِۙۖ"}, {"verse_key": "89:11", "text_uthmani": "اَلَّذ۪ينَ طَغَوْا فِي الْبِلَادِۙۖ"}, {"verse_key": "89:12", "text_uthmani": "فَاَكْثَرُوا ف۪يهَا الْفَسَادَۙۖ"}, {"verse_key": "89:13", "text_uthmani": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍۙۖ"}, {"verse_key": "89:14", "text_uthmani": "اِنَّ رَبَّكَ لَبِالْمِرْصَادِۜ"}, {"verse_key": "89:15", "text_uthmani": "فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰيهُ رَبُّهُ فَاَكْرَمَهُ وَنَعَّمَهُ فَيَقُولُ رَبّ۪ٓي اَكْرَمَنِۜ"}, {"verse_key": "89:16", "text_uthmani": "وَاَمَّٓا اِذَا مَا ابْتَلٰيهُ فَقَدَرَ عَلَيْهِ رِزْقَهُ فَيَقُولُ رَبّ۪ٓي اَهَانَنِۚ"}, {"verse_key": "89:17", "text_uthmani": "كَلَّا بَلْ لَا تُكْرِمُونَ الْيَت۪يمَۙ"}, {"verse_key": "89:18", "text_uthmani": "وَلَا تَحَٓاضُّونَ عَلٰى طَعَامِ الْمِسْك۪ينِۙ"}, {"verse_key": "89:19", "text_uthmani": "وَتَأْكُلُونَ التُّرَاثَ اَكْلًا لَمًّاۙ"}, {"verse_key": "89:20", "text_uthmani": "وَتُحِبُّونَ الْمَالَ حُبًّا جَمًّاۜ"}, {"verse_key": "89:21", "text_uthmani": "كَلَّٓا اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّاۙ"}, {"verse_key": "89:22", "text_uthmani": "وَجَٓاءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّاۚ"}, {"verse_key": "89:23", "text_uthmani": "وَج۪ٓيءَ يَوْمَئِذٍ بِجَهَنَّمَ يَوْمَئِذٍ يَتَذَكَّرُ الْاِنْسَانُ وَاَنّٰى لَهُ الذِّكْرٰىۜ"}, {"verse_key": "89:24", "text_uthmani": "يَقُولُ يَا لَيْتَن۪ي قَدَّمْتُ لِحَيَات۪يۚ"}, {"verse_key": "89:25", "text_uthmani": "فَيَوْمَئِذٍ لَا يُعَذِّبُ عَذَابَهُٓ اَحَدٌۙ"}, {"verse_key": "89:26", "text_uthmani": "وَلَا يُوثِقُ وَثَاقَهُٓ اَحَدٌۜ"}, {"verse_key": "89:27", "text_uthmani": "يَٓا اَيَّتُهَا النَّفْسُ الْمُطْمَئِنَّةُۗ"}, {"verse_key": "89:28", "text_uthmani": "اِرْجِع۪ٓي اِلٰى رَبِّكِ رَاضِيَةً مَرْضِيَّةًۚ"}, {"verse_key": "89:29", "text_uthmani": "فَادْخُل۪ي ف۪ي عِبَاد۪يۙ"}, {"verse_key": "89:30", "text_uthmani": "وَادْخُل۪ي جَنَّت۪ي"}]}