{"verses": [{"verse_key": "84:1", "text_uthmani": "اِذَا السَّمَٓاءُ انْشَقَّتْۙ"}, {"verse_key": "84:2", "text_uthmani": "وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۙ"}, {"verse_key": "84:3", "text_uthmani": "وَاِذَا الْاَرْضُ مُدَّتْۙ"}, {"verse_key": "84:4", "text_uthmani": "وَاَلْقَتْ مَا ف۪يهَا وَتَخَلَّتْۙ"}, {"verse_key": "84:5", "text_uthmani": "وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْۜ"}, {"verse_key": "84:6", "text_uthmani": "يَٓا اَيُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰى رَبِّكَ كَدْحًا فَمُلَاق۪يهِۚ"}, {"verse_key": "84:7", "text_uthmani": "فَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ بِيَم۪ينِه۪ۙ"}, {"verse_key": "84:8", "text_uthmani": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَس۪يرًاۙ"}, {"verse_key": "84:9", "text_uthmani": "وَيَنْقَلِبُ اِلٰٓى اَهْلِه۪ مَسْرُورًاۜ"}, {"verse_key": "84:10", "text_uthmani": "وَاَمَّا مَنْ اُو۫تِيَ كِتَابَهُ وَرَٓاءَ ظَهْرِه۪ۙ"}, {"verse_key": "84:11", "text_uthmani": "فَسَوْفَ يَدْعُو ثُبُورًاۙ"}, {"verse_key": "84:12", "text_uthmani": "وَيَصْلٰى سَع۪يرًاۜ"}, {"verse_key": "84:13", "text_uthmani": "اِنَّهُ كَانَ ف۪ٓي اَهْلِه۪ مَسْرُورًا"}, {"verse_key": "84:14", "text_uthmani": "اِنَّهُ ظَنَّ اَنْ لَنْ يَحُورَۚۛ"}, {"verse_key": "84:15", "text_uthmani": "بَلٰىۚۛ اِنَّ رَبَّهُ كَانَ بِه۪ بَص۪يرًاۜ"}, {"verse_key": "84:16", "text_uthmani": "فَلَٓا اُقْسِمُ بِالشَّفَقِۙ"}, {"verse_key": "84:17", "text_uthmani": "وَالَّيْلِ وَمَا وَسَقَۙ"}, {"verse_key": "84:18", "text_uthmani": "وَالْقَمَرِ اِذَا اتَّسَقَۙ"}, {"verse_key": "84:19", "text_uthmani": "لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍۜ"}, {"verse_key": "84:20", "text_uthmani": "فَمَا لَهُمْ لَا يُؤْمِنُونَۙ"}, {"verse_key": "84:21", "text_uthmani": "وَاِذَا قُرِئَ عَلَيْهِمُ الْقُرْاٰنُ لَا يَسْجُدُونَۜ"}, {"verse_key": "84:22", "text_uthmani": "بَلِ الَّذ۪ينَ كَفَرُوا يُكَذِّبُونَۘ"}, {"verse_key": "84:23", "text_uthmani": "وَاللّٰهُ اَعْلَمُ بِمَا يُوعُونَۘ"}, {"verse_key": "84:24", "text_uthmani": "فَبَشِّرْهُمْ بِعَذَابٍ اَل۪يمٍۙ"}, {"verse_key": "84:25", "text_uthmani": "اِلَّا الَّذ۪ينَ اٰمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ اَجْرٌ غَيْرُ مَمْنُونٍ"}]}