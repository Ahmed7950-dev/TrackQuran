{"verses": [{"verse_key": "75:1", "text_uthmani": "لَٓا اُقْسِمُ بِيَوْمِ الْقِيٰمَةِۙ"}, {"verse_key": "75:2", "text_uthmani": "وَلَٓا اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ"}, {"verse_key": "75:3", "text_uthmani": "اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَجْمَعَ عِظَامَهُۜ"}, {"verse_key": "75:4", "text_uthmani": "بَلٰى قَادِر۪ينَ عَلٰٓى اَنْ نُسَوِّيَ بَنَانَهُ"}, {"verse_key": "75:5", "text_uthmani": "بَلْ يُر۪يدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهُۚ"}, {"verse_key": "75:6", "text_uthmani": "يَسْـَٔلُ اَيَّانَ يَوْمُ الْقِيٰمَةِۜ"}, {"verse_key": "75:7", "text_uthmani": "فَاِذَا بَرِقَ الْبَصَرُۙ"}, {"verse_key": "75:8", "text_uthmani": "وَخَسَفَ الْقَمَرُۙ"}, {"verse_key": "75:9", "text_uthmani": "وَجُمِعَ الشَّمْسُ وَالْقَمَرُۙ"}, {"verse_key": "75:10", "text_uthmani": "يَقُولُ الْاِنْسَانُ يَوْمَئِذٍ اَيْنَ الْمَفَرُّۚ"}, {"verse_key": "75:11", "text_uthmani": "كَلَّا لَا وَزَرَۚ"}, {"verse_key": "75:12", "text_uthmani": "اِلٰى رَبِّكَ يَوْمَئِذٍۨ الْمُسْتَقَرُّۜ"}, {"verse_key": "75:13", "text_uthmani": "يُنَبَّؤُا الْاِنْسَانُ يَوْمَئِذٍ بِمَا قَدَّمَ وَاَخَّرَۜ"}, {"verse_key": "75:14", "text_uthmani": "بَلِ الْاِنْسَانُ عَلٰى نَفْسِه۪ بَص۪يرَةٌۙ"}, {"verse_key": "75:15", "text_uthmani": "وَلَوْ اَلْقٰى مَعَاذ۪يرَهُۜ"}, {"verse_key": "75:16", "text_uthmani": "لَا تُحَرِّكْ بِه۪ لِسَانَكَ لِتَعْجَلَ بِه۪ۜ"}, {"verse_key": "75:17", "text_uthmani": "اِنَّ عَلَيْنَا جَمْعَهُ وَقُرْاٰنَهُۚ"}, {"verse_key": "75:18", "text_uthmani": "فَاِذَا قَرَأْنَاهُ فَاتَّبِعْ قُرْاٰنَهُۚ"}, {"verse_key": "75:19", "text_uthmani": "ثُمَّ اِنَّ عَلَيْنَا بَيَانَهُۜ"}, {"verse_key": "75:20", "text_uthmani": "كَلَّا بَلْ تُحِبُّونَ الْعَاجِلَةَۙ"}, {"verse_key": "75:21", "text_uthmani": "وَتَذَرُونَ الْاٰخِرَةَۜ"}, {"verse_key": "75:22", "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ نَاضِرَةٌۙ"}, {"verse_key": "75:23", "text_uthmani": "اِلٰى رَبِّهَا نَاظِرَةٌۚ"}, {"verse_key": "75:24", "text_uthmani": "وَوُجُوهٌ يَوْمَئِذٍ بَاسِرَةٌۙ"}, {"verse_key": "75:25", "text_uthmani": "تَظُنُّ اَنْ يُفْعَلَ بِهَا فَاقِرَةٌۜ"}, {"verse_key": "75:26", "text_uthmani": "كَلَّٓا اِذَا بَلَغَتِ التَّرَاقِيَۙ"}, {"verse_key": "75:27", "text_uthmani": "وَق۪يلَ مَنْ۔ رَاقٍۙ"}, {"verse_key": "75:28", "text_uthmani": "وَظَنَّ اَنَّهُ الْفِرَاقُۙ"}, {"verse_key": "75:29", "text_uthmani": "وَالْتَفَّتِ السَّاقُ بِالسَّاقِۙ"}, {"verse_key": "75:30", "text_uthmani": "اِلٰى رَبِّكَ يَوْمَئِذٍۨ الْمَسَاقُۜ۟"}, {"verse_key": "75:31", "text_uthmani": "فَلَا صَدَّقَ وَلَا صَلّٰىۙ"}, {"verse_key": "75:32", "text_uthmani": "وَلٰكِنْ كَذَّبَ وَتَوَلّٰىۙ"}, {"verse_key": "75:33", "text_uthmani": "ثُمَّ ذَهَبَ اِلٰٓى اَهْلِه۪ يَتَمَطّٰىۜ"}, {"verse_key": "75:34", "text_uthmani": "اَوْلٰى لَكَ فَاَوْلٰىۙ"}, {"verse_key": "75:35", "text_uthmani": "ثُمَّ اَوْلٰى لَكَ فَاَوْلٰىۜ"}, {"verse_key": "75:36", "text_uthmani": "اَيَحْسَبُ الْاِنْسَانُ اَنْ يُتْرَكَ سُدًىۜ"}, {"verse_key": "75:37", "text_uthmani": "اَلَمْ يَكُ نُطْفَةً مِنْ مَنِيٍّ يُمْنٰىۙ"}, {"verse_key": "75:38", "text_uthmani": "ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰىۙ"}, {"verse_key": "75:39", "text_uthmani": "فَجَعَلَ مِنْهُ الزَّوْجَيْنِ الذَّكَرَ وَالْاُنْثٰىۜ"}, {"verse_key": "75:40", "text_uthmani": "اَلَيْسَ ذٰلِكَ بِقَادِرٍ عَلٰٓى اَنْ يُحْيِيَ الْمَوْتٰى"}]}