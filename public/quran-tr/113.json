{"verses": [{"verse_key": "113:1", "text_uthmani": "قُلْ اَعُوذُ بِرَبِّ الْفَلَقِۙ"}, {"verse_key": "113:2", "text_uthmani": "مِنْ شَرِّ مَا خَلَقَۙ"}, {"verse_key": "113:3", "text_uthmani": "وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَۙ"}, {"verse_key": "113:4", "text_uthmani": "وَمِنْ شَرِّ النَّفَّاثَاتِ فِي الْعُقَدِۙ"}, {"verse_key": "113:5", "text_uthmani": "وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ"}]}