{"verses": [{"verse_key": "92:1", "text_uthmani": "وَالَّيْلِ اِذَا يَغْشٰىۙ"}, {"verse_key": "92:2", "text_uthmani": "وَالنَّهَارِ اِذَا تَجَلّٰىۙ"}, {"verse_key": "92:3", "text_uthmani": "وَمَا خَلَقَ الذَّكَرَ وَالْاُنْثٰىۙ"}, {"verse_key": "92:4", "text_uthmani": "اِنَّ سَعْيَكُمْ لَشَتّٰىۜ"}, {"verse_key": "92:5", "text_uthmani": "فَاَمَّا مَنْ اَعْطٰى وَاتَّقٰىۙ"}, {"verse_key": "92:6", "text_uthmani": "وَصَدَّقَ بِالْحُسْنٰىۙ"}, {"verse_key": "92:7", "text_uthmani": "فَسَنُيَسِّرُهُ لِلْيُسْرٰىۜ"}, {"verse_key": "92:8", "text_uthmani": "وَاَمَّا مَنْ بَخِلَ وَاسْتَغْنٰىۙ"}, {"verse_key": "92:9", "text_uthmani": "وَكَذَّبَ بِالْحُسْنٰىۙ"}, {"verse_key": "92:10", "text_uthmani": "فَسَنُيَسِّرُهُ لِلْعُسْرٰىۜ"}, {"verse_key": "92:11", "text_uthmani": "وَمَا يُغْن۪ي عَنْهُ مَالُهُٓ اِذَا تَرَدّٰىۜ"}, {"verse_key": "92:12", "text_uthmani": "اِنَّ عَلَيْنَا لَلْهُدٰىۘ"}, {"verse_key": "92:13", "text_uthmani": "وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُو۫لٰى"}, {"verse_key": "92:14", "text_uthmani": "فَاَنْذَرْتُكُمْ نَارًا تَلَظّٰىۚ"}, {"verse_key": "92:15", "text_uthmani": "لَا يَصْلٰيهَٓا اِلَّا الْاَشْقٰىۙ"}, {"verse_key": "92:16", "text_uthmani": "اَلَّذ۪ي كَذَّبَ وَتَوَلّٰىۜ"}, {"verse_key": "92:17", "text_uthmani": "وَسَيُجَنَّبُهَا الْاَتْقٰىۙ"}, {"verse_key": "92:18", "text_uthmani": "اَلَّذ۪ي يُؤْت۪ي مَالَهُ يَتَزَكّٰىۚ"}, {"verse_key": "92:19", "text_uthmani": "وَمَا لِاَحَدٍ عِنْدَهُ مِنْ نِعْمَةٍ تُجْزٰىۙ"}, {"verse_key": "92:20", "text_uthmani": "اِلَّا ابْتِغَٓاءَ وَجْهِ رَبِّهِ الْاَعْلٰىۚ"}, {"verse_key": "92:21", "text_uthmani": "وَلَسَوْفَ يَرْضٰى"}]}