{"verses": [{"verse_key": "88:1", "text_uthmani": "هَلْ اَتٰيكَ حَد۪يثُ الْغَاشِيَةِۜ"}, {"verse_key": "88:2", "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ خَاشِعَةٌۙ"}, {"verse_key": "88:3", "text_uthmani": "عَامِلَةٌ نَاصِبَةٌۙ"}, {"verse_key": "88:4", "text_uthmani": "تَصْلٰى نَارًا حَامِيَةًۙ"}, {"verse_key": "88:5", "text_uthmani": "تُسْقٰى مِنْ عَيْنٍ اٰنِيَةٍۜ"}, {"verse_key": "88:6", "text_uthmani": "لَيْسَ لَهُمْ طَعَامٌ اِلَّا مِنْ ضَر۪يعٍۙ"}, {"verse_key": "88:7", "text_uthmani": "لَا يُسْمِنُ وَلَا يُغْن۪ي مِنْ جُوعٍۜ"}, {"verse_key": "88:8", "text_uthmani": "وُجُوهٌ يَوْمَئِذٍ نَاعِمَةٌۙ"}, {"verse_key": "88:9", "text_uthmani": "لِسَعْيِهَا رَاضِيَةٌۙ"}, {"verse_key": "88:10", "text_uthmani": "ف۪ي جَنَّةٍ عَالِيَةٍۙ"}, {"verse_key": "88:11", "text_uthmani": "لَا تَسْمَعُ ف۪يهَا لَاغِيَةًۜ"}, {"verse_key": "88:12", "text_uthmani": "ف۪يهَا عَيْنٌ جَارِيَةٌۢ"}, {"verse_key": "88:13", "text_uthmani": "ف۪يهَا سُرُرٌ مَرْفُوعَةٌۙ"}, {"verse_key": "88:14", "text_uthmani": "وَاَكْوَابٌ مَوْضُوعَةٌۙ"}, {"verse_key": "88:15", "text_uthmani": "وَنَمَارِقُ مَصْفُوفَةٌۙ"}, {"verse_key": "88:16", "text_uthmani": "وَزَرَابِيُّ مَبْثُوثَةٌۜ"}, {"verse_key": "88:17", "text_uthmani": "اَفَلَا يَنْظُرُونَ اِلَى الْاِبِلِ كَيْفَ خُلِقَتْ۠"}, {"verse_key": "88:18", "text_uthmani": "وَاِلَى السَّمَٓاءِ كَيْفَ رُفِعَتْ۠"}, {"verse_key": "88:19", "text_uthmani": "وَاِلَى الْجِبَالِ كَيْفَ نُصِبَتْ۠"}, {"verse_key": "88:20", "text_uthmani": "وَاِلَى الْاَرْضِ كَيْفَ سُطِحَتْ۠"}, {"verse_key": "88:21", "text_uthmani": "فَذَكِّرْ اِنَّمَٓا اَنْتَ مُذَكِّرٌۜ"}, {"verse_key": "88:22", "text_uthmani": "لَسْتَ عَلَيْهِمْ بِمُصَيْطِرٍۙ"}, {"verse_key": "88:23", "text_uthmani": "اِلَّا مَنْ تَوَلّٰى وَكَفَرَۙ"}, {"verse_key": "88:24", "text_uthmani": "فَيُعَذِّبُهُ اللّٰهُ الْعَذَابَ الْاَكْبَرَۜ"}, {"verse_key": "88:25", "text_uthmani": "اِنَّ اِلَيْنَٓا اِيَابَهُمْۙ"}, {"verse_key": "88:26", "text_uthmani": "ثُمَّ اِنَّ عَلَيْنَا حِسَابَهُمْ"}]}