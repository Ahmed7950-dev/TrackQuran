{"verses": [{"verse_key": "102:1", "text_uthmani": "اَلْهٰيكُمُ التَّكَاثُرُۙ"}, {"verse_key": "102:2", "text_uthmani": "حَتّٰى زُرْتُمُ الْمَقَابِرَۜ"}, {"verse_key": "102:3", "text_uthmani": "كَلَّا سَوْفَ تَعْلَمُونَۙ"}, {"verse_key": "102:4", "text_uthmani": "ثُمَّ كَلَّا سَوْفَ تَعْلَمُونَۜ"}, {"verse_key": "102:5", "text_uthmani": "كَلَّا لَوْ تَعْلَمُونَ عِلْمَ الْيَق۪ينِۜ"}, {"verse_key": "102:6", "text_uthmani": "لَتَرَوُنَّ الْجَح۪يمَۙ"}, {"verse_key": "102:7", "text_uthmani": "ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَق۪ينِۙ"}, {"verse_key": "102:8", "text_uthmani": "ثُمَّ لَتُسْـَٔلُنَّ يَوْمَئِذٍ عَنِ النَّع۪يمِ"}]}